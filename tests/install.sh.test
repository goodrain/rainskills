#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
unset RAINBOND_JWT RAINBOND_URL RAINBOND_USERNAME RAINBOND_PASSWORD

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

assert_file_exists() {
  local path="$1"
  [[ -f "$path" ]] || fail "expected file to exist: $path"
}

assert_contains() {
  local path="$1"
  local pattern="$2"
  grep -F -- "$pattern" "$path" >/dev/null || fail "expected '$pattern' in $path"
}

assert_not_contains() {
  local path="$1"
  local pattern="$2"
  if grep -F -- "$pattern" "$path" >/dev/null; then
    fail "did not expect '$pattern' in $path"
  fi
}

assert_line_count() {
  local path="$1"
  local pattern="$2"
  local expected="$3"
  local count
  count="$(grep -Fxc -- "$pattern" "$path" || true)"
  [[ "$count" == "$expected" ]] || fail "expected '$pattern' to appear $expected times in $path, got $count"
}

assert_occurrence_count() {
  local path="$1"
  local pattern="$2"
  local expected="$3"
  python3 - "$path" "$pattern" "$expected" <<'PY'
import sys

path, pattern, expected = sys.argv[1], sys.argv[2], int(sys.argv[3])
with open(path, encoding="utf-8", errors="replace") as fh:
    count = fh.read().count(pattern)
if count != expected:
    raise SystemExit(
        "expected {!r} to appear {} times in {}, got {}".format(
            pattern, expected, path, count
        )
    )
PY
}

assert_appears_before() {
  local path="$1"
  local first="$2"
  local second="$3"
  python3 - "$path" "$first" "$second" <<'PY'
import sys

path, first, second = sys.argv[1:4]
with open(path, encoding="utf-8", errors="replace") as fh:
    content = fh.read()

first_index = content.find(first)
second_index = content.find(second)
if first_index < 0 or second_index < 0 or first_index >= second_index:
    raise SystemExit("expected {!r} before {!r}".format(first, second))
PY
}

wait_for_file_line_count() {
  local path="$1"
  local expected="$2"
  local attempt count
  for ((attempt = 0; attempt < 100; attempt++)); do
    if [[ -f "$path" ]]; then
      count="$(wc -l < "$path" | tr -d ' ')"
    else
      count="0"
    fi
    if [[ "$count" == "$expected" ]]; then
      return 0
    fi
    sleep 0.02
  done
  fail "expected $expected lines in $path, got ${count:-0}"
}

file_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

make_test_jwt() {
  local exp="$1"
  python3 - "$exp" <<'PY'
import base64
import json
import sys

exp = int(sys.argv[1])

def b64(payload):
    raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")

print("{}.{}.signature".format(
    b64({"alg": "HS256", "typ": "JWT"}),
    b64({"sub": "demo", "exp": exp}),
))
PY
}

make_fake_commands() {
  local bin_dir="$1"
  mkdir -p "$bin_dir"

  cat >"$bin_dir/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "${TEST_LOG_DIR}/codex.log"
if [[ "${1:-}" == "mcp" && "${2:-}" == "add" ]]; then
  if [[ "${TEST_FAKE_CODEX_ADD_FAIL:-}" == "1" ]]; then
    exit 1
  fi
  name="${3:-}"
  shift 3
  url=""
  env_var=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --url)
        url="$2"
        shift 2
        ;;
      --bearer-token-env-var)
        env_var="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done
  mkdir -p "$HOME/.codex"
  cat > "$HOME/.codex/config.toml" <<CONFIG
[mcp_servers.${name}]
url = "${url}"
bearer_token_env_var = "${env_var}"
CONFIG
  exit 0
fi
echo "unsupported fake codex command: $*" >&2
exit 1
EOF

  cat >"$bin_dir/claude" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "${TEST_LOG_DIR}/claude.log"
if [[ "${1:-}" == "mcp" && "${2:-}" == "add" ]]; then
  if [[ "${TEST_FAKE_CLAUDE_ADD_FAIL:-}" == "1" ]]; then
    exit 1
  fi
  shift 2
  scope="local"
  transport=""
  header=""
  name=""
  url=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --scope)
        scope="$2"
        shift 2
        ;;
      --transport)
        transport="$2"
        shift 2
        ;;
      -H|--header)
        header="$2"
        shift 2
        ;;
      http://*|https://*)
        url="$1"
        shift
        ;;
      *)
        if [[ -z "$name" ]]; then
          name="$1"
        fi
        shift
        ;;
    esac
  done
  mkdir -p "$HOME"
  auth_value="${header#Authorization: }"
  cat > "$HOME/.claude.json" <<CONFIG
{
  "mcpServers": {
    "${name}": {
      "type": "${transport}",
      "url": "${url}",
      "headers": {
        "Authorization": "${auth_value}"
      }
    }
  }
}
CONFIG
  exit 0
fi
echo "unsupported fake claude command: $*" >&2
exit 1
EOF

  cat >"$bin_dir/pi" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "${TEST_LOG_DIR}/pi.log"
EOF

  cat >"$bin_dir/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "${TEST_LOG_DIR}/curl.log"

output_file=""
header_file=""
write_out=""
request_data=""
url=""
args=("$@")
i=0
while [[ $i -lt ${#args[@]} ]]; do
  arg="${args[$i]}"
  case "$arg" in
    --output)
      i=$((i + 1))
      output_file="${args[$i]}"
      ;;
    --dump-header)
      i=$((i + 1))
      header_file="${args[$i]}"
      ;;
    --write-out)
      i=$((i + 1))
      write_out="${args[$i]}"
      ;;
    --data|--data-binary)
      i=$((i + 1))
      request_data="${args[$i]}"
      ;;
    http://*|https://*)
      url="$arg"
      ;;
  esac
  i=$((i + 1))
done

body='{}'
if [[ "$url" == "https://log.rainbond.com/api/rainskills/installations" ]]; then
  printf '%s\n' "$request_data" >> "${TEST_LOG_DIR}/install-report.log"
  if [[ "${TEST_FAKE_INSTALL_REPORT_FAIL:-}" == "1" ]]; then
    exit 22
  fi
  body='{"status":"success"}'
elif [[ "$url" == *"/console/users/details" ]]; then
  if [[ -n "${TEST_FAKE_DETAILS_HTTP_CODE:-}" && "${TEST_FAKE_DETAILS_HTTP_CODE}" != "200" ]]; then
    body='{"code":500,"msg":"details unavailable"}'
  else
    body='{"code":200,"data":{"bean":{"enterprise_id":"enterprise-test"}}}'
  fi
elif [[ "$url" == *"/console/users/login" ]]; then
  login_token="${TEST_FAKE_LOGIN_TOKEN:-}"
  if [[ -z "$login_token" ]]; then
    login_token="$(
      python3 - <<'PY'
import base64
import json

def b64(payload):
    raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")

print("{}.{}.signature".format(
    b64({"alg": "HS256", "typ": "JWT"}),
    b64({"sub": "demo", "exp": 1893456000}),
))
PY
    )"
  fi
  body="{\"code\":200,\"data\":{\"bean\":{\"token\":\"${login_token}\"}}}"
elif [[ "$url" == *"/console/mcp/device/code" ]]; then
  body='Not Found'
elif [[ "$url" == *"/console/mcp/rainskills/api/query" ]]; then
  if [[ -n "${TEST_FAKE_API_HTTP_CODE:-}" && "${TEST_FAKE_API_HTTP_CODE}" != "200" ]]; then
    body='{"code":404,"msg":"not found"}'
  else
    body='{"jsonrpc":"2.0","id":1,"result":{"tools":[]}}'
  fi
elif [[ "$url" == *"/console/mcp/query" || "$url" == *"/console/mcp/rainskills/codex/query" || "$url" == *"/console/mcp/rainskills/claude-code/query" || "$url" == *"/console/mcp/rainskills/pi/query" ]]; then
  if [[ -n "${TEST_FAKE_MCP_HTTP_CODE:-}" && "${TEST_FAKE_MCP_HTTP_CODE}" != "200" ]]; then
    body='{"code":404,"msg":"not found"}'
  else
    body='{"jsonrpc":"2.0","id":1,"result":{"serverInfo":{"name":"rainbond-console-mcp"}}}'
  fi
else
  body='{"code":404}'
fi

if [[ -n "$header_file" ]]; then
  {
    if [[ "$url" == *"/console/mcp/device/code" ]]; then
      printf 'HTTP/1.1 404 Not Found\r\n'
      printf 'Content-Type: text/plain\r\n'
    else
      printf 'HTTP/1.1 200 OK\r\n'
      printf 'Content-Type: application/json\r\n'
    fi
    if [[ -n "${TEST_FAKE_RENEWED_TOKEN:-}" ]]; then
      printf 'X-Renewed-Token: %s\r\n' "${TEST_FAKE_RENEWED_TOKEN}"
      printf 'Authorization: GRJWT %s\r\n' "${TEST_FAKE_RENEWED_TOKEN}"
    fi
    printf '\r\n'
  } > "$header_file"
fi

if [[ -n "$output_file" ]]; then
  printf '%s' "$body" > "$output_file"
else
  printf '%s' "$body"
fi

if [[ "$write_out" == "%{http_code}" ]]; then
  if [[ "$url" == *"/console/mcp/device/code" ]]; then
    printf '404'
  elif [[ "$url" == *"/console/mcp/rainskills/api/query" ]]; then
    printf '%s' "${TEST_FAKE_API_HTTP_CODE:-200}"
  elif [[ "$url" == *"/console/mcp/"*"query" && -n "${TEST_FAKE_MCP_HTTP_CODE:-}" ]]; then
    printf '%s' "$TEST_FAKE_MCP_HTTP_CODE"
  elif [[ "$url" == *"/console/users/details" && -n "${TEST_FAKE_DETAILS_HTTP_CODE:-}" ]]; then
    printf '%s' "$TEST_FAKE_DETAILS_HTTP_CODE"
  else
    printf '200'
  fi
fi
EOF

  chmod +x "$bin_dir/codex" "$bin_dir/claude" "$bin_dir/pi" "$bin_dir/curl"
}

make_fake_node() {
  local bin_dir="$1"
  cat >"$bin_dir/node" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == "-p" ]]; then
  printf '20\n'
  exit 0
fi
exit 0
EOF
  chmod +x "$bin_dir/node"
}

make_faulty_file_command() {
  local bin_dir="$1"
  local command="$2"
  local real_command="$3"
  cat >"$bin_dir/$command" <<EOF
#!/usr/bin/env bash
if [[ "\${TEST_FAIL_BRIDGE_STAGE:-}" == "signal" && "$command" == "cp" && "\$*" == *".rainskills-tools.js."* ]]; then
  kill -TERM "\$PPID"
  sleep 1
  exit 143
fi
if [[ "\${TEST_FAIL_BRIDGE_STAGE:-}" == "$command" && "\$*" == *".rainskills-tools.js."* ]]; then
  exit 1
fi
exec "$real_command" "\$@"
EOF
  chmod +x "$bin_dir/$command"
}

run_installer() {
  local workdir="$1"
  shift
  (
    cd "$REPO_ROOT"
    if [[ "${TEST_RAINBOND_PASSWORD+x}" == "x" ]]; then
      export RAINBOND_PASSWORD="$TEST_RAINBOND_PASSWORD"
    else
      export RAINBOND_PASSWORD="secret-password"
    fi
    HOME="$workdir/home" \
    SHELL="/bin/zsh" \
    TEST_LOG_DIR="$workdir/logs" \
    PATH="$workdir/bin:/usr/bin:/bin" \
    TEST_FAKE_MCP_HTTP_CODE="${TEST_FAKE_MCP_HTTP_CODE:-}" \
    TEST_FAKE_API_HTTP_CODE="${TEST_FAKE_API_HTTP_CODE:-}" \
    TEST_FAKE_LOGIN_TOKEN="${TEST_FAKE_LOGIN_TOKEN:-}" \
    TEST_FAKE_RENEWED_TOKEN="${TEST_FAKE_RENEWED_TOKEN:-}" \
    TEST_FAKE_CODEX_ADD_FAIL="${TEST_FAKE_CODEX_ADD_FAIL:-}" \
    TEST_FAKE_CLAUDE_ADD_FAIL="${TEST_FAKE_CLAUDE_ADD_FAIL:-}" \
    TEST_FAKE_INSTALL_REPORT_FAIL="${TEST_FAKE_INSTALL_REPORT_FAIL:-}" \
    TEST_FAKE_DETAILS_HTTP_CODE="${TEST_FAKE_DETAILS_HTTP_CODE:-}" \
    bash "$REPO_ROOT/install.sh" "$@"
  )
}

run_interactive_installer_with_pty() {
  local workdir="$1"
  local output_file="$2"
  python3 - "$REPO_ROOT" "$workdir" "$output_file" <<'PY'
import os
import pty
import select
import sys
import time

repo_root, workdir, output_file = sys.argv[1:4]
responses = [
    "\n",
    "2\n",
    "1\n",
    "http://rainbond.internal\n",
    "y\n",
    "demo\n",
]
expected_prompts = [
    "请输入选项 [1-2]",
    "请输入选项 [1-2]",
    "请输入选项 [1-2]",
    "Rainbond Console 地址: ",
    "是否继续使用明文 HTTP 连接？[y/N]: ",
    "Rainbond 用户名: ",
]

env = os.environ.copy()
env["HOME"] = os.path.join(workdir, "home")
env["SHELL"] = "/bin/zsh"
env["TEST_LOG_DIR"] = os.path.join(workdir, "logs")
env["PATH"] = os.path.join(workdir, "bin") + ":/usr/bin:/bin"
env["RAINBOND_PASSWORD"] = "secret-password"

pid, master_fd = pty.fork()
if pid == 0:
    os.chdir(repo_root)
    os.execvpe("bash", ["bash", os.path.join(repo_root, "install.sh"), "codex", "--force"], env)

buffer = bytearray()
response_index = 0
search_offset = 0
deadline = time.monotonic() + 10

while True:
    if time.monotonic() > deadline:
        with open(output_file, "wb") as fh:
            fh.write(buffer)
        try:
            os.kill(pid, 9)
        except OSError:
            pass
        sys.exit(124)
    ready, _, _ = select.select([master_fd], [], [], 0.2)
    if master_fd in ready:
        try:
            chunk = os.read(master_fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        buffer.extend(chunk)
        text = buffer.decode("utf-8", errors="replace")
        while response_index < len(responses):
            expected = expected_prompts[response_index]
            prompt_index = text.find(expected, search_offset)
            if prompt_index >= 0:
                os.write(master_fd, responses[response_index].encode("utf-8"))
                response_index += 1
                search_offset = prompt_index + len(expected)
            else:
                break
    try:
        done_pid, status = os.waitpid(pid, os.WNOHANG)
    except ChildProcessError:
        done_pid, status = pid, 0
    if done_pid == pid:
        exit_code = os.waitstatus_to_exitcode(status)
        with open(output_file, "wb") as fh:
            fh.write(buffer)
        sys.exit(exit_code)

try:
    _, status = os.waitpid(pid, 0)
    exit_code = os.waitstatus_to_exitcode(status)
except ChildProcessError:
    exit_code = 0

with open(output_file, "wb") as fh:
    fh.write(buffer)
sys.exit(exit_code)
PY
}

run_interactive_no_platform_with_pty() {
  local workdir="$1"
  local output_file="$2"
  python3 - "$REPO_ROOT" "$workdir" "$output_file" <<'PY'
import os
import pty
import select
import sys
import time

repo_root, workdir, output_file = sys.argv[1:4]
responses = ["1\n", "2\n", "2\n"]
prompts = [
    "请输入选项 [1-5]",
    "请输入选项 [1-2]",
    "请输入选项 [1-2]",
]

env = os.environ.copy()
env["HOME"] = os.path.join(workdir, "home")
env["TEST_LOG_DIR"] = os.path.join(workdir, "logs")
env["PATH"] = os.path.join(workdir, "bin") + ":/usr/bin:/bin"

pid, master_fd = pty.fork()
if pid == 0:
    os.chdir(repo_root)
    os.execvpe("bash", ["bash", os.path.join(repo_root, "install.sh")], env)

buffer = bytearray()
response_index = 0
search_offset = 0
deadline = time.monotonic() + 10
status = None

while time.monotonic() < deadline:
    ready, _, _ = select.select([master_fd], [], [], 0.2)
    if master_fd in ready:
        try:
            chunk = os.read(master_fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        buffer.extend(chunk)
        text = buffer.decode("utf-8", errors="replace")
        if response_index < len(responses):
            prompt_index = text.find(prompts[response_index], search_offset)
            if prompt_index >= 0:
                os.write(master_fd, responses[response_index].encode("utf-8"))
                response_index += 1
                search_offset = prompt_index + len(prompts[response_index - 1])
    done_pid, child_status = os.waitpid(pid, os.WNOHANG)
    if done_pid == pid:
        status = child_status
        break

if status is None:
    try:
        os.kill(pid, 9)
    except OSError:
        pass
    with open(output_file, "wb") as fh:
        fh.write(buffer)
    sys.exit(124)

with open(output_file, "wb") as fh:
    fh.write(buffer)
sys.exit(os.waitstatus_to_exitcode(status))
PY
}

test_noninteractive_http_requires_explicit_opt_in() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  set +e
  run_installer "$tmpdir" all --non-interactive --rainbond-url http://rainbond.internal --username demo >/tmp/rainbond-install-test.out 2>&1
  local rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected installer to reject non-interactive HTTP without explicit opt-in"
  grep -F -- "--allow-insecure-http" /tmp/rainbond-install-test.out >/dev/null || fail "expected insecure http guidance"
}

test_posix_openclaw_is_rejected() {
  local tmpdir output_file rc
  tmpdir="$(mktemp -d)"
  output_file="/tmp/rainbond-install-openclaw-removed.out"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  set +e
  run_installer "$tmpdir" openclaw --skip-mcp --force >"$output_file" 2>&1
  rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected POSIX installer to reject openclaw"
  grep -F -- "macOS/Linux 安装器不再支持 OpenClaw" "$output_file" >/dev/null \
    || fail "expected removed OpenClaw guidance"
  rm -rf "$tmpdir"
}

test_noninteractive_without_rainbond_params_skips_cli_authorization() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  TEST_RAINBOND_PASSWORD="" run_installer "$tmpdir" all --non-interactive --force >/tmp/rainbond-install-skip.out 2>&1

  [[ ! -f "$tmpdir/home/.rainbond/credentials.env" ]] || fail "did not expect credentials when CLI authorization is skipped"
  grep -F -- "非交互模式下未提供 Rainbond 连接信息，已跳过 CLI 授权。" /tmp/rainbond-install-skip.out >/dev/null || fail "expected auto-skip guidance"
}

test_cli_install_writes_private_credentials_without_client_mcp() {
  local tmpdir default_token output_file
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  default_token="$(make_test_jwt 1893456000)"

  output_file="$tmpdir/install.out"
  run_installer "$tmpdir" pi --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http --force >"$output_file" 2>&1

  assert_file_exists "$tmpdir/home/.pi/agent/skills/rainbond-app-assistant/SKILL.md"
  assert_file_exists "$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  assert_file_exists "$tmpdir/home/.rainbond/credentials.env"
  assert_contains "$tmpdir/home/.rainbond/credentials.env" "export RAINBOND_JWT='$default_token'"
  assert_contains "$tmpdir/home/.rainbond/credentials.env" "RAINBOND_ALLOW_INSECURE_HTTP='true'"
  [[ "$(file_mode "$tmpdir/home/.rainbond/credentials.env")" == "600" ]] || fail "expected credentials permissions to be 600"
  assert_contains "$tmpdir/logs/curl.log" "/console/mcp/rainskills/api/query"
  [[ ! -f "$tmpdir/logs/codex.log" ]] || fail "CLI-only install must not invoke Codex MCP"
  [[ ! -f "$tmpdir/logs/claude.log" ]] || fail "CLI-only install must not invoke Claude MCP"
  [[ ! -e "$tmpdir/home/.pi/agent/extensions/rainskills-mcp.ts" ]] || fail "CLI-only install must not install Pi extension"
  assert_contains "$output_file" "Skills 将通过本机 RainSkills CLI 调用 Rainbond。"
  assert_not_contains "$output_file" "当前客户端无需 Rainbond MCP"
  assert_not_contains "$output_file" "未修改 Codex/Claude/Pi 的 MCP 配置"
}

test_codex_install_writes_narrow_read_only_network_rule() {
  local tmpdir rule bridge
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  TEST_RAINBOND_PASSWORD="" run_installer "$tmpdir" codex --non-interactive --force \
    >"$tmpdir/install.out" 2>&1

  bridge="$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  rule="$tmpdir/home/.codex/rules/rainskills.rules"
  assert_file_exists "$bridge"
  assert_file_exists "$rule"
  [[ "$(file_mode "$rule")" == "600" ]] || fail "expected Codex rule permissions to be 600"
  assert_contains "$rule" 'prefix_rule('
  assert_contains "$rule" 'decision = "allow"'
  assert_contains "$rule" "\"$bridge\""
  assert_contains "$rule" '["status", "list", "describe", "read"]'
  assert_not_contains "$rule" '"call"'
  assert_not_contains "$rule" 'network_access'
  assert_contains "$tmpdir/install.out" "Codex 只读网络规则"

  rm -rf "$tmpdir/home/.codex/rules"
  TEST_RAINBOND_PASSWORD="" run_installer "$tmpdir" claude --non-interactive --force \
    >"$tmpdir/claude-install.out" 2>&1
  [[ ! -e "$rule" ]] || fail "Claude-only install must not create a Codex rule"
}

test_installer_configures_both_platforms_and_shell_autoload() {
  local tmpdir
  local default_token
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  default_token="$(make_test_jwt 1893456000)"

  run_installer "$tmpdir" all --non-interactive --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force

  assert_file_exists "$tmpdir/home/.rainbond/mcp.env"
  assert_contains "$tmpdir/home/.rainbond/mcp.env" "export RAINBOND_JWT='$default_token'"
  [[ "$(file_mode "$tmpdir/home/.rainbond/mcp.env")" == "600" ]] || fail "expected token file permissions to be 600"

  assert_file_exists "$tmpdir/home/.zshrc"
  assert_contains "$tmpdir/home/.zshrc" "# >>> rainbond skills mcp >>>"
  assert_contains "$tmpdir/home/.zshrc" 'source "$HOME/.rainbond/mcp.env"'
  assert_line_count "$tmpdir/home/.zshrc" "# >>> rainbond skills mcp >>>" "1"

  assert_file_exists "$tmpdir/home/.codex/config.toml"
  assert_contains "$tmpdir/home/.codex/config.toml" "url = \"http://rainbond.internal/console/mcp/rainskills/codex/query\""
  assert_contains "$tmpdir/home/.codex/config.toml" "bearer_token_env_var = \"RAINBOND_JWT\""
  assert_file_exists "$tmpdir/home/.codex/skills/rainbond-fullstack-bootstrap/references/source-build-parameter-guide.md"

  assert_file_exists "$tmpdir/home/.claude.json"
  assert_contains "$tmpdir/home/.claude.json" "\"url\": \"http://rainbond.internal/console/mcp/rainskills/claude-code/query\""
  assert_contains "$tmpdir/home/.claude.json" "\"Authorization\": \"GRJWT \${RAINBOND_JWT}\""
  assert_file_exists "$tmpdir/home/.claude/skills/rainbond-fullstack-bootstrap/references/source-build-parameter-guide.md"

  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/users/login"
  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/mcp/rainskills/codex/query"
  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/mcp/rainskills/claude-code/query"
  assert_contains "$tmpdir/logs/codex.log" "mcp add rainbond --url http://rainbond.internal/console/mcp/rainskills/codex/query --bearer-token-env-var RAINBOND_JWT"
  assert_contains "$tmpdir/logs/claude.log" "mcp add --scope user --transport http rainbond http://rainbond.internal/console/mcp/rainskills/claude-code/query -H Authorization: GRJWT \${RAINBOND_JWT}"
}

test_installer_configures_pi_extension_and_uses_pi_endpoint() {
  local tmpdir
