#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
unset RAINBOND_JWT RAINBOND_URL RAINBOND_USERNAME RAINBOND_PASSWORD

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

assert_file_exists() {
  local path="$1"
  [[ -f "$path" ]] || fail "expected file to exist: $path"
}

assert_contains() {
  local path="$1"
  local pattern="$2"
  grep -F -- "$pattern" "$path" >/dev/null || fail "expected '$pattern' in $path"
}

assert_not_contains() {
  local path="$1"
  local pattern="$2"
  if grep -F -- "$pattern" "$path" >/dev/null; then
    fail "did not expect '$pattern' in $path"
  fi
}

assert_line_count() {
  local path="$1"
  local pattern="$2"
  local expected="$3"
  local count
  count="$(grep -Fxc -- "$pattern" "$path" || true)"
  [[ "$count" == "$expected" ]] || fail "expected '$pattern' to appear $expected times in $path, got $count"
}

assert_occurrence_count() {
  local path="$1"
  local pattern="$2"
  local expected="$3"
  python3 - "$path" "$pattern" "$expected" <<'PY'
import sys

path, pattern, expected = sys.argv[1], sys.argv[2], int(sys.argv[3])
with open(path, encoding="utf-8", errors="replace") as fh:
    count = fh.read().count(pattern)
if count != expected:
    raise SystemExit(
        "expected {!r} to appear {} times in {}, got {}".format(
            pattern, expected, path, count
        )
    )
PY
}

assert_appears_before() {
  local path="$1"
  local first="$2"
  local second="$3"
  python3 - "$path" "$first" "$second" <<'PY'
import sys

path, first, second = sys.argv[1:4]
with open(path, encoding="utf-8", errors="replace") as fh:
    content = fh.read()

first_index = content.find(first)
second_index = content.find(second)
if first_index < 0 or second_index < 0 or first_index >= second_index:
    raise SystemExit("expected {!r} before {!r}".format(first, second))
PY
}

wait_for_file_line_count() {
  local path="$1"
  local expected="$2"
  local attempt count
  for ((attempt = 0; attempt < 100; attempt++)); do
    if [[ -f "$path" ]]; then
      count="$(wc -l < "$path" | tr -d ' ')"
    else
      count="0"
    fi
    if [[ "$count" == "$expected" ]]; then
      return 0
    fi
    sleep 0.02
  done
  fail "expected $expected lines in $path, got ${count:-0}"
}

file_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

make_test_jwt() {
  local exp="$1"
  python3 - "$exp" <<'PY'
import base64
import json
import sys

exp = int(sys.argv[1])

def b64(payload):
    raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")

print("{}.{}.signature".format(
    b64({"alg": "HS256", "typ": "JWT"}),
    b64({"sub": "demo", "exp": exp}),
))
PY
}

make_fake_commands() {
  local bin_dir="$1"
  mkdir -p "$bin_dir"

  cat >"$bin_dir/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "${TEST_LOG_DIR}/curl.log"

output_file=""
header_file=""
write_out=""
request_data=""
url=""
args=("$@")
i=0
while [[ $i -lt ${#args[@]} ]]; do
  arg="${args[$i]}"
  case "$arg" in
    --output)
      i=$((i + 1))
      output_file="${args[$i]}"
      ;;
    --dump-header)
      i=$((i + 1))
      header_file="${args[$i]}"
      ;;
    --write-out)
      i=$((i + 1))
      write_out="${args[$i]}"
      ;;
    --data|--data-binary)
      i=$((i + 1))
      request_data="${args[$i]}"
      ;;
    http://*|https://*)
      url="$arg"
      ;;
  esac
  i=$((i + 1))
done

body='{}'
if [[ "$url" == "https://log.rainbond.com/api/rainskills/installations" ]]; then
  printf '%s\n' "$request_data" >> "${TEST_LOG_DIR}/install-report.log"
  if [[ "${TEST_FAKE_INSTALL_REPORT_FAIL:-}" == "1" ]]; then
    exit 22
  fi
  body='{"status":"success"}'
elif [[ "$url" == *"/console/users/details" ]]; then
  if [[ -n "${TEST_FAKE_DETAILS_HTTP_CODE:-}" && "${TEST_FAKE_DETAILS_HTTP_CODE}" != "200" ]]; then
    body='{"code":500,"msg":"details unavailable"}'
  else
    body='{"code":200,"data":{"bean":{"enterprise_id":"enterprise-test"}}}'
  fi
elif [[ "$url" == *"/console/users/login" ]]; then
  login_token="${TEST_FAKE_LOGIN_TOKEN:-}"
  if [[ -z "$login_token" ]]; then
    login_token="$(
      python3 - <<'PY'
import base64
import json

def b64(payload):
    raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")

print("{}.{}.signature".format(
    b64({"alg": "HS256", "typ": "JWT"}),
    b64({"sub": "demo", "exp": 1893456000}),
))
PY
    )"
  fi
  body="{\"code\":200,\"data\":{\"bean\":{\"token\":\"${login_token}\"}}}"
elif [[ "$url" == *"/console/mcp/device/code" ]]; then
  body='Not Found'
elif [[ "$url" == *"/console/mcp/rainskills/api/query" ]]; then
  if [[ -n "${TEST_FAKE_API_HTTP_CODE:-}" && "${TEST_FAKE_API_HTTP_CODE}" != "200" ]]; then
    body='{"code":404,"msg":"not found"}'
  else
    body='{"jsonrpc":"2.0","id":1,"result":{"tools":[]}}'
  fi
else
  body='{"code":404}'
fi

if [[ -n "$header_file" ]]; then
  {
    if [[ "$url" == *"/console/mcp/device/code" ]]; then
      printf 'HTTP/1.1 404 Not Found\r\n'
      printf 'Content-Type: text/plain\r\n'
    else
      printf 'HTTP/1.1 200 OK\r\n'
      printf 'Content-Type: application/json\r\n'
    fi
    if [[ -n "${TEST_FAKE_RENEWED_TOKEN:-}" ]]; then
      printf 'X-Renewed-Token: %s\r\n' "${TEST_FAKE_RENEWED_TOKEN}"
      printf 'Authorization: GRJWT %s\r\n' "${TEST_FAKE_RENEWED_TOKEN}"
    fi
    printf '\r\n'
  } > "$header_file"
fi

if [[ -n "$output_file" ]]; then
  printf '%s' "$body" > "$output_file"
else
  printf '%s' "$body"
fi

if [[ "$write_out" == "%{http_code}" ]]; then
  if [[ "$url" == *"/console/mcp/device/code" ]]; then
    printf '404'
  elif [[ "$url" == *"/console/mcp/rainskills/api/query" ]]; then
    printf '%s' "${TEST_FAKE_API_HTTP_CODE:-200}"
  elif [[ "$url" == *"/console/users/details" && -n "${TEST_FAKE_DETAILS_HTTP_CODE:-}" ]]; then
    printf '%s' "$TEST_FAKE_DETAILS_HTTP_CODE"
  else
    printf '200'
  fi
fi
EOF

  chmod +x "$bin_dir/curl"
}

make_fake_node() {
  local bin_dir="$1"
  cat >"$bin_dir/node" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == "-p" ]]; then
  printf '20\n'
  exit 0
fi
exit 0
EOF
  chmod +x "$bin_dir/node"
}

make_faulty_file_command() {
  local bin_dir="$1"
  local command="$2"
  local real_command="$3"
  cat >"$bin_dir/$command" <<EOF
#!/usr/bin/env bash
if [[ "\${TEST_FAIL_BRIDGE_STAGE:-}" == "signal" && "$command" == "cp" && "\$*" == *".rainskills-tools.js."* ]]; then
  kill -TERM "\$PPID"
  sleep 1
  exit 143
fi
if [[ "\${TEST_FAIL_BRIDGE_STAGE:-}" == "$command" && "\$*" == *".rainskills-tools.js."* ]]; then
  exit 1
fi
exec "$real_command" "\$@"
EOF
  chmod +x "$bin_dir/$command"
}

run_installer() {
  local workdir="$1"
  shift
  (
    cd "$REPO_ROOT"
    if [[ "${TEST_RAINBOND_PASSWORD+x}" == "x" ]]; then
      export RAINBOND_PASSWORD="$TEST_RAINBOND_PASSWORD"
    else
      export RAINBOND_PASSWORD="secret-password"
    fi
    HOME="$workdir/home" \
    SHELL="/bin/zsh" \
    TEST_LOG_DIR="$workdir/logs" \
    PATH="$workdir/bin:/usr/bin:/bin" \
    TEST_FAKE_API_HTTP_CODE="${TEST_FAKE_API_HTTP_CODE:-}" \
    TEST_FAKE_LOGIN_TOKEN="${TEST_FAKE_LOGIN_TOKEN:-}" \
    TEST_FAKE_RENEWED_TOKEN="${TEST_FAKE_RENEWED_TOKEN:-}" \
    TEST_FAKE_INSTALL_REPORT_FAIL="${TEST_FAKE_INSTALL_REPORT_FAIL:-}" \
    TEST_FAKE_DETAILS_HTTP_CODE="${TEST_FAKE_DETAILS_HTTP_CODE:-}" \
    bash "$REPO_ROOT/install.sh" "$@"
  )
}

run_interactive_installer_with_pty() {
  local workdir="$1"
  local output_file="$2"
  python3 - "$REPO_ROOT" "$workdir" "$output_file" <<'PY'
import os
import pty
import select
import sys
import time

repo_root, workdir, output_file = sys.argv[1:4]
responses = [
    "\n",
    "2\n",
    "1\n",
    "http://rainbond.internal\n",
    "y\n",
    "demo\n",
]
expected_prompts = [
    "请输入选项 [1-2]",
    "请输入选项 [1-2]",
    "请输入选项 [1-2]",
    "Rainbond Console 地址: ",
    "是否继续使用明文 HTTP 连接？[y/N]: ",
    "Rainbond 用户名: ",
]

env = os.environ.copy()
env["HOME"] = os.path.join(workdir, "home")
env["SHELL"] = "/bin/zsh"
env["TEST_LOG_DIR"] = os.path.join(workdir, "logs")
env["PATH"] = os.path.join(workdir, "bin") + ":/usr/bin:/bin"
env["RAINBOND_PASSWORD"] = "secret-password"

pid, master_fd = pty.fork()
if pid == 0:
    os.chdir(repo_root)
    os.execvpe("bash", ["bash", os.path.join(repo_root, "install.sh"), "codex", "--force"], env)

buffer = bytearray()
response_index = 0
search_offset = 0
deadline = time.monotonic() + 10

while True:
    if time.monotonic() > deadline:
        with open(output_file, "wb") as fh:
            fh.write(buffer)
        try:
            os.kill(pid, 9)
        except OSError:
            pass
        sys.exit(124)
    ready, _, _ = select.select([master_fd], [], [], 0.2)
    if master_fd in ready:
        try:
            chunk = os.read(master_fd, 4096)
        except OSError:
            _, status = os.waitpid(pid, 0)
            break
        if not chunk:
            break
        buffer.extend(chunk)
        text = buffer.decode("utf-8", errors="replace")
        while response_index < len(responses):
            expected = expected_prompts[response_index]
            prompt_index = text.find(expected, search_offset)
            if prompt_index >= 0:
                os.write(master_fd, responses[response_index].encode("utf-8"))
                response_index += 1
                search_offset = prompt_index + len(expected)
            else:
                break
    try:
        done_pid, status = os.waitpid(pid, os.WNOHANG)
    except ChildProcessError:
        done_pid, status = pid, 0
    if done_pid == pid:
        exit_code = os.waitstatus_to_exitcode(status)
        with open(output_file, "wb") as fh:
            fh.write(buffer)
        sys.exit(exit_code)

try:
    _, status = os.waitpid(pid, 0)
    exit_code = os.waitstatus_to_exitcode(status)
except ChildProcessError:
    exit_code = 0

with open(output_file, "wb") as fh:
    fh.write(buffer)
sys.exit(exit_code)
PY
}

test_noninteractive_http_requires_explicit_opt_in() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  set +e
  run_installer "$tmpdir" all --non-interactive --rainbond-url http://rainbond.internal --username demo >/tmp/rainbond-install-test.out 2>&1
  local rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected installer to reject non-interactive HTTP without explicit opt-in"
  grep -F -- "--allow-insecure-http" /tmp/rainbond-install-test.out >/dev/null || fail "expected insecure http guidance"
}

test_posix_openclaw_is_rejected() {
  local tmpdir output_file rc
  tmpdir="$(mktemp -d)"
  output_file="/tmp/rainbond-install-openclaw-removed.out"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  set +e
  run_installer "$tmpdir" openclaw --skip-mcp --force >"$output_file" 2>&1
  rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected POSIX installer to reject openclaw"
  grep -F -- "macOS/Linux 安装器不再支持 OpenClaw" "$output_file" >/dev/null \
    || fail "expected removed OpenClaw guidance"
  rm -rf "$tmpdir"
}

test_noninteractive_without_rainbond_params_skips_cli_authorization() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  TEST_RAINBOND_PASSWORD="" run_installer "$tmpdir" all --non-interactive --force >/tmp/rainbond-install-skip.out 2>&1

  [[ ! -f "$tmpdir/home/.rainbond/credentials.env" ]] || fail "did not expect credentials when CLI authorization is skipped"
  grep -F -- "非交互模式下未提供 Rainbond 连接信息，已跳过 CLI 授权。" /tmp/rainbond-install-skip.out >/dev/null || fail "expected auto-skip guidance"
}

test_cli_install_writes_private_credentials_without_client_mcp() {
  local tmpdir default_token output_file
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  default_token="$(make_test_jwt 1893456000)"

  output_file="$tmpdir/install.out"
  run_installer "$tmpdir" pi --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http --force >"$output_file" 2>&1

  assert_file_exists "$tmpdir/home/.pi/agent/skills/rainbond-app-assistant/SKILL.md"
  assert_file_exists "$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  assert_file_exists "$tmpdir/home/.rainbond/credentials.env"
  assert_contains "$tmpdir/home/.rainbond/credentials.env" "export RAINBOND_JWT='$default_token'"
  assert_contains "$tmpdir/home/.rainbond/credentials.env" "RAINBOND_ALLOW_INSECURE_HTTP='true'"
  [[ "$(file_mode "$tmpdir/home/.rainbond/credentials.env")" == "600" ]] || fail "expected credentials permissions to be 600"
  assert_contains "$tmpdir/logs/curl.log" "/console/mcp/rainskills/api/query"
  [[ ! -f "$tmpdir/logs/codex.log" ]] || fail "CLI-only install must not invoke Codex MCP"
  [[ ! -f "$tmpdir/logs/claude.log" ]] || fail "CLI-only install must not invoke Claude MCP"
  [[ ! -e "$tmpdir/home/.pi/agent/extensions/rainskills-mcp.ts" ]] || fail "CLI-only install must not install Pi extension"
  assert_contains "$output_file" "Skills 将通过本机 RainSkills CLI 调用 Rainbond。"
  assert_not_contains "$output_file" "当前客户端无需 Rainbond MCP"
  assert_not_contains "$output_file" "未修改 Codex/Claude/Pi 的 MCP 配置"
}

test_codex_install_writes_narrow_read_only_network_rule() {
  local tmpdir rule bridge
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  TEST_RAINBOND_PASSWORD="" run_installer "$tmpdir" codex --non-interactive --force \
    >"$tmpdir/install.out" 2>&1

  bridge="$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  rule="$tmpdir/home/.codex/rules/rainskills.rules"
  assert_file_exists "$bridge"
  assert_file_exists "$rule"
  [[ "$(file_mode "$rule")" == "600" ]] || fail "expected Codex rule permissions to be 600"
  assert_contains "$rule" 'prefix_rule('
  assert_contains "$rule" 'decision = "allow"'
  assert_contains "$rule" "\"$bridge\""
  assert_contains "$rule" '["status", "list", "describe", "read"]'
  assert_not_contains "$rule" '"call"'
  assert_not_contains "$rule" 'network_access'
  assert_contains "$tmpdir/install.out" "Codex 只读网络规则"

  rm -rf "$tmpdir/home/.codex/rules"
  TEST_RAINBOND_PASSWORD="" run_installer "$tmpdir" claude --non-interactive --force \
    >"$tmpdir/claude-install.out" 2>&1
  [[ ! -e "$rule" ]] || fail "Claude-only install must not create a Codex rule"
}

test_interactive_prompts_are_visible() {
  local tmpdir
  local output_file
  tmpdir="$(mktemp -d)"
  output_file="$tmpdir/interactive.out"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  if ! run_interactive_installer_with_pty "$tmpdir" "$output_file"; then
    printf 'interactive installer output:\n' >&2
    tail -n 120 "$output_file" >&2 || true
    return 1
  fi

  assert_contains "$output_file" "RainSkills 文件已安装完成。"
  assert_contains "$output_file" "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_connection]"
  assert_occurrence_count "$output_file" "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_connection]" "1"
  assert_contains "$output_file" "请选择要连接的 Rainbond："
  assert_contains "$output_file" "1) Rainbond Cloud"
  assert_contains "$output_file" "无需自行安装 Rainbond，登录后即可使用"
  assert_contains "$output_file" "2) 私有化部署"
  assert_contains "$output_file" "你现在是否已经有可以访问的 Rainbond 平台？"
  assert_contains "$output_file" "1) 已经有，填写平台地址"
  assert_contains "$output_file" "2) 还没有，帮我安装"
  assert_contains "$output_file" "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_console_url]"
  assert_occurrence_count "$output_file" "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_console_url]" "1"
  assert_contains "$output_file" "请发送浏览器中访问 Rainbond 控制台的完整地址，例如："
  assert_contains "$output_file" "https://rainbond.example.com"
  assert_contains "$output_file" "Rainbond Console 地址: "
  assert_contains "$output_file" "Rainbond 用户名: "
  assert_not_contains "$output_file" "Rainbond 平台安装将在独立步骤中继续"
  assert_contains "$output_file" "请输入 1 或 2。"
  assert_not_contains "$output_file" "回车默认 1"
  assert_appears_before "$output_file" \
    "RainSkills 文件已安装完成。" \
    "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_connection]"
  assert_appears_before "$output_file" \
    "请输入选项 [1-2]: " \
    "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_console_url]"
  assert_appears_before "$output_file" \
    "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_console_url]" \
    "Rainbond Console 地址: "
}

test_saas_mode_does_not_show_self_hosted_install_hint() {
  local tmpdir token output_file
  tmpdir="$(mktemp -d)"
  output_file="$tmpdir/saas.out"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  token="$(make_test_jwt 1893456000)"

  run_installer "$tmpdir" codex --non-interactive --saas --token "$token" --force \
    >"$output_file" 2>&1

  assert_not_contains "$output_file" "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_console_url]"
  assert_not_contains "$output_file" "你现在是否已经有可以访问的 Rainbond 平台？"
}

test_expired_cached_token_reauthenticates_before_write() {
  local tmpdir expired_token fresh_token
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  expired_token="$(make_test_jwt 1700000000)"
  fresh_token="$(make_test_jwt 1893456000)"

  RAINBOND_JWT="$expired_token" \
  RAINBOND_URL="http://rainbond.internal" \
  TEST_FAKE_LOGIN_TOKEN="$fresh_token" \
    run_installer "$tmpdir" all --non-interactive --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
    >/tmp/rainbond-install-expired-cache.out 2>&1

  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/users/login"
  assert_contains "$tmpdir/home/.rainbond/credentials.env" "export RAINBOND_JWT='$fresh_token'"
  grep -F -- "已过期" /tmp/rainbond-install-expired-cache.out >/dev/null || fail "expected expired token guidance"
}

test_expiring_cached_token_reauthenticates_before_write() {
  local tmpdir expiring_token fresh_token
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  expiring_token="$(make_test_jwt "$(( $(date +%s) + 300 ))")"
  fresh_token="$(make_test_jwt 1893456000)"

  RAINBOND_JWT="$expiring_token" \
  RAINBOND_URL="http://rainbond.internal" \
  TEST_FAKE_LOGIN_TOKEN="$fresh_token" \
    run_installer "$tmpdir" all --non-interactive --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
    >/tmp/rainbond-install-expiring-cache.out 2>&1

  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/users/login"
  assert_contains "$tmpdir/home/.rainbond/credentials.env" "export RAINBOND_JWT='$fresh_token'"
  grep -F -- "即将过期" /tmp/rainbond-install-expiring-cache.out >/dev/null || fail "expected expiring token guidance"
}

test_expired_flag_token_fails_without_writing_config() {
  local tmpdir expired_token
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  expired_token="$(make_test_jwt 1700000000)"

  set +e
  run_installer "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal --token "$expired_token" --allow-insecure-http --force \
    >/tmp/rainbond-install-expired-flag.out 2>&1
  local rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected expired --token to fail"
  [[ ! -f "$tmpdir/home/.rainbond/credentials.env" ]] || fail "did not expect token file for expired --token"
  grep -F -- "--token 提供的 Rainbond JWT 已过期" /tmp/rainbond-install-expired-flag.out >/dev/null || fail "expected expired --token guidance"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "2"
  python3 - "$tmpdir/logs/install-report.log" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
failed = [record for record in records if record["phase"] == "failed"]
if len(failed) != 1:
    raise SystemExit("expected exactly one failed report: {!r}".format(records))
if failed[0]["failure_stage"] != "authorization" or failed[0]["failure_category"] != "authorization_failed":
    raise SystemExit("unexpected authorization failure report: {!r}".format(failed[0]))
PY
}

test_installer_reports_installation_lifecycle() {
  local tmpdir report_file
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  run_installer "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http --force >/tmp/rainbond-install-report.out 2>&1

  report_file="$tmpdir/logs/install-report.log"
  wait_for_file_line_count "$report_file" "3"
  python3 - "$report_file" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
by_phase = {record["phase"]: record for record in records}
if set(by_phase) != {"started", "authorized", "configured"} or len(records) != 3:
    raise SystemExit("unexpected installation phases: {!r}".format([record["phase"] for record in records]))

attempt_ids = {record["install_attempt_id"] for record in records}
if len(attempt_ids) != 1 or not next(iter(attempt_ids)):
    raise SystemExit("installation reports must share one non-empty attempt id")

started = by_phase["started"]
authorized = by_phase["authorized"]
configured = by_phase["configured"]
if started != {
    "install_attempt_id": started["install_attempt_id"],
    "eid": "",
    "install_client": "codex",
    "action": "install",
    "phase": "started",
    "status": "started",
    "failure_stage": "",
    "failure_category": "",
}:
    raise SystemExit("unexpected started report: {!r}".format(started))

for record, phase in ((authorized, "authorized"), (configured, "configured")):
    if record["eid"] != "enterprise-test":
        raise SystemExit("{} report is missing enterprise id".format(phase))
    if record["install_client"] != "codex" or record["action"] != "install":
        raise SystemExit("unexpected {} metadata: {!r}".format(phase, record))
    if record["status"] != "success":
        raise SystemExit("unexpected {} status: {!r}".format(phase, record))

raw = open(sys.argv[1], encoding="utf-8").read()
for secret_marker in ("GRJWT", "Authorization", ".signature", "secret-password"):
    if secret_marker in raw:
        raise SystemExit("installation report leaked secret marker: {}".format(secret_marker))
PY
}

test_installation_reporting_failures_do_not_block_installation() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  TEST_FAKE_INSTALL_REPORT_FAIL=1 \
    run_installer "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal \
      --username demo --allow-insecure-http --force >/tmp/rainbond-install-report-failure.out 2>&1

  assert_file_exists "$tmpdir/home/.rainbond/credentials.env"
  [[ ! -e "$tmpdir/home/.codex/config.toml" ]] || fail "CLI-only install must not create Codex MCP config"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "3"
}

test_enterprise_lookup_failure_does_not_block_installation() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  TEST_FAKE_DETAILS_HTTP_CODE=500 \
    run_installer "$tmpdir" claude --non-interactive --rainbond-url http://rainbond.internal \
      --username demo --allow-insecure-http --force >/tmp/rainbond-install-details-failure.out 2>&1

  assert_file_exists "$tmpdir/home/.rainbond/credentials.env"
  [[ ! -e "$tmpdir/home/.claude.json" ]] || fail "CLI-only install must not create Claude MCP config"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "1"
  python3 - "$tmpdir/logs/install-report.log" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
if [record["phase"] for record in records] != ["started"]:
    raise SystemExit("enterprise lookup failure should leave only started report: {!r}".format(records))
if records[0]["install_client"] != "claude_code":
    raise SystemExit("unexpected install client: {!r}".format(records[0]))
PY
}

test_unhandled_skill_installation_failure_is_reported() {
  local tmpdir source_dir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  source_dir="$tmpdir/source"
  mkdir -p "$tmpdir/home" "$tmpdir/logs" "$source_dir/rainbond-invalid"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  cp "$REPO_ROOT/install.sh" "$source_dir/install.sh"

  set +e
  HOME="$tmpdir/home" \
  TEST_LOG_DIR="$tmpdir/logs" \
  PATH="$tmpdir/bin:/usr/bin:/bin" \
    bash "$source_dir/install.sh" codex --force \
      >/tmp/rainbond-install-invalid-skill.out 2>&1
  local rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected invalid skill directory to fail installation"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "2"
  python3 - "$tmpdir/logs/install-report.log" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
failed = next((record for record in records if record["phase"] == "failed"), None)
if failed is None:
    raise SystemExit("missing unhandled failure report: {!r}".format(records))
if failed["phase"] != "failed" or failed["failure_stage"] != "skill_installation":
    raise SystemExit("unexpected unhandled failure report: {!r}".format(failed))
if failed["failure_category"] != "skill_installation_failed":
    raise SystemExit("unexpected unhandled failure category: {!r}".format(failed))
PY
}

test_bridge_install_replaces_updates_and_rejects_symlink_targets() {
  local tmpdir bridge rc
  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  run_installer "$tmpdir" codex --api-only --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http --force
  bridge="$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  printf 'stale\n' >"$bridge"
  run_installer "$tmpdir" codex --api-only --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http
  assert_not_contains "$bridge" "stale"

  rm -rf "$tmpdir/home/.rainbond/bin"
  ln -s "$tmpdir/logs" "$tmpdir/home/.rainbond/bin"
  set +e
  run_installer "$tmpdir" codex --api-only --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http --force >/tmp/rainskills-bridge-symlink.out 2>&1
  rc=$?
  set -e
  [[ $rc -ne 0 ]] || fail "expected symlink bridge directory rejection"
  [[ ! -e "$tmpdir/logs/rainskills-tools.js" ]] || fail "must not write through bridge directory symlink"
  [[ -z "$(find "$tmpdir/home/.rainbond" -maxdepth 1 -name '.bin.rainskills-*' -print -quit)" ]] \
    || fail "temporary bridge paths must be cleaned"
  rm -rf "$tmpdir"
}

test_bridge_install_failures_preserve_old_target_and_clean_staging() {
  local stage tmpdir bridge rc
  for stage in cp chmod mv; do
    tmpdir="$(mktemp -d)"
    mkdir -p "$tmpdir/home/.rainbond/bin" "$tmpdir/logs"
    make_fake_commands "$tmpdir/bin"
    make_fake_node "$tmpdir/bin"
    make_faulty_file_command "$tmpdir/bin" cp /bin/cp
    make_faulty_file_command "$tmpdir/bin" chmod /bin/chmod
    make_faulty_file_command "$tmpdir/bin" mv /bin/mv
    bridge="$tmpdir/home/.rainbond/bin/rainskills-tools.js"
    printf 'old-bridge\n' >"$bridge"
    /bin/chmod 700 "$tmpdir/home/.rainbond" "$tmpdir/home/.rainbond/bin" "$bridge"

    set +e
    TEST_FAIL_BRIDGE_STAGE="$stage" run_installer "$tmpdir" codex --api-only --non-interactive \
      --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
      >/tmp/rainskills-bridge-${stage}-failure.out 2>&1
    rc=$?
    set -e
    [[ $rc -ne 0 ]] || fail "expected bridge $stage failure"
    assert_contains "$bridge" "old-bridge"
    [[ -z "$(find "$tmpdir/home/.rainbond/bin" -maxdepth 1 \
      \( -name '.rainskills-tools.js.*' -o -name '.rainskills-tools.js.backup.*' \) -print -quit)" ]] \
      || fail "bridge $stage failure must clean staging files"
    rm -rf "$tmpdir"
  done
}

test_bridge_signal_cleanup_preserves_old_target() {
  local tmpdir bridge rc
  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home/.rainbond/bin" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  make_faulty_file_command "$tmpdir/bin" cp /bin/cp
  bridge="$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  printf 'old-bridge\n' >"$bridge"
  /bin/chmod 700 "$tmpdir/home/.rainbond" "$tmpdir/home/.rainbond/bin" "$bridge"
  set +e
  TEST_FAIL_BRIDGE_STAGE=signal run_installer "$tmpdir" codex --api-only --non-interactive \
    --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
    >/tmp/rainskills-bridge-signal.out 2>&1
  rc=$?
  set -e
  [[ $rc -eq 143 ]] || fail "expected SIGTERM cleanup exit 143, got $rc"
  assert_contains "$bridge" "old-bridge"
  [[ -z "$(find "$tmpdir/home/.rainbond/bin" -maxdepth 1 -name '.rainskills-tools.js.*' -print -quit)" ]] \
    || fail "SIGTERM must clean bridge staging file"
  rm -rf "$tmpdir"
}

