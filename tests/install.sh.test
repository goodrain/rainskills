test_refresh_rewrites_token_and_refreshes_every_installed_client() {
  local tmpdir expired_token fresh_token
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home/.rainbond" "$tmpdir/home/.codex" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  expired_token="$(make_test_jwt 1700000000)"
  fresh_token="$(make_test_jwt 1893456000)"

  cat > "$tmpdir/home/.rainbond/mcp.env" <<EOF
export RAINBOND_JWT='$expired_token'
export RAINBOND_URL='http://rainbond.internal'
EOF
  chmod 600 "$tmpdir/home/.rainbond/mcp.env"

  cat > "$tmpdir/home/.codex/config.toml" <<EOF
[mcp_servers.rainbond]
url = "http://rainbond.internal/console/mcp/query"
bearer_token_env_var = "RAINBOND_JWT"
EOF
  cat > "$tmpdir/home/.claude.json" <<'EOF'
{
  "mcpServers": {
    "rainbond": {
      "type": "http",
      "url": "http://rainbond.internal/console/mcp/query",
      "headers": {"Authorization": "GRJWT ${RAINBOND_JWT}"}
    }
  }
}
EOF
  TEST_FAKE_LOGIN_TOKEN="$fresh_token" \
    run_installer "$tmpdir" refresh --non-interactive --self-hosted --username demo --allow-insecure-http \
    >/tmp/rainbond-install-refresh.out 2>&1

  assert_contains "$tmpdir/home/.rainbond/mcp.env" "export RAINBOND_JWT='$fresh_token'"
  assert_contains "$tmpdir/home/.rainbond/mcp.env" "export RAINBOND_URL='http://rainbond.internal'"
  [[ "$(file_mode "$tmpdir/home/.rainbond/mcp.env")" == "600" ]] || fail "refresh should keep mcp.env permissions at 600"

  assert_contains "$tmpdir/home/.codex/config.toml" "url = \"http://rainbond.internal/console/mcp/rainskills/codex/query\""
  assert_contains "$tmpdir/home/.claude.json" "\"url\": \"http://rainbond.internal/console/mcp/rainskills/claude-code/query\""
  assert_file_exists "$tmpdir/home/.codex/config.toml.rainskills-backup"
  assert_file_exists "$tmpdir/home/.claude.json.rainskills-backup"

  [[ ! -d "$tmpdir/home/.codex/skills" ]] || fail "refresh should not copy skills to codex"
  [[ ! -d "$tmpdir/home/.claude/skills" ]] || fail "refresh should not copy skills to claude"

  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/users/login"
  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/mcp/rainskills/codex/query"
  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/mcp/rainskills/claude-code/query"
  grep -F -- "使用 ~/.rainbond/mcp.env 中已记录的地址" /tmp/rainbond-install-refresh.out >/dev/null \
    || fail "expected refresh to log cached URL reuse"
  grep -F -- "请重启 Claude Code 或 Codex" /tmp/rainbond-install-refresh.out >/dev/null \
    || fail "expected restart guidance"

  assert_contains "$tmpdir/home/.zshrc" "# >>> rainbond skills mcp >>>"
  assert_line_count "$tmpdir/home/.zshrc" "# >>> rainbond skills mcp >>>" "1"
}

