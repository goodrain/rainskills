test_installer_reports_installation_lifecycle() {
  local tmpdir report_file telemetry_file
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  run_mcp_configuration "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http --force >/tmp/rainbond-install-report.out 2>&1

  report_file="$tmpdir/logs/install-report.log"
  wait_for_file_line_count "$report_file" "3"
  telemetry_file="$tmpdir/home/.rainbond/rainskills/telemetry/events.jsonl"
  wait_for_file_line_count "$telemetry_file" "5"
  python3 - "$report_file" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
by_phase = {record["phase"]: record for record in records}
if set(by_phase) != {"started", "authorized", "configured"} or len(records) != 3:
    raise SystemExit("unexpected installation phases: {!r}".format([record["phase"] for record in records]))

attempt_ids = {record["install_attempt_id"] for record in records}
if len(attempt_ids) != 1 or not next(iter(attempt_ids)):
    raise SystemExit("installation reports must share one non-empty attempt id")

started = by_phase["started"]
authorized = by_phase["authorized"]
configured = by_phase["configured"]
if started != {
    "install_attempt_id": started["install_attempt_id"],
    "eid": "",
    "install_client": "codex",
    "action": "install",
    "phase": "started",
    "status": "started",
    "failure_stage": "",
    "failure_category": "",
}:
    raise SystemExit("unexpected started report: {!r}".format(started))

for record, phase in ((authorized, "authorized"), (configured, "configured")):
    if record["eid"] != "enterprise-test":
        raise SystemExit("{} report is missing enterprise id".format(phase))
    if record["install_client"] != "codex" or record["action"] != "install":
        raise SystemExit("unexpected {} metadata: {!r}".format(phase, record))
    if record["status"] != "success":
        raise SystemExit("unexpected {} status: {!r}".format(phase, record))

raw = open(sys.argv[1], encoding="utf-8").read()
for secret_marker in ("GRJWT", "Authorization", ".signature", "secret-password"):
    if secret_marker in raw:
        raise SystemExit("installation report leaked secret marker: {}".format(secret_marker))
PY
  python3 - "$telemetry_file" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
if not records or records[0]["schema"] != "rainskills.lifecycle-event.v1":
    raise SystemExit("missing lifecycle schema")
if len({record["install_attempt_id"] for record in records}) != 1:
    raise SystemExit("lifecycle events must share one attempt id")
if any("Bearer" in open(sys.argv[1], encoding="utf-8").read() for _ in [0]):
    raise SystemExit("lifecycle events leaked authorization data")
if not any(record["lifecycle_phase"] == "configure_cli" and record["lifecycle_status"] == "completed" for record in records):
    raise SystemExit("missing configure lifecycle completion")
PY
}

test_installation_reporting_failures_do_not_block_installation() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  TEST_FAKE_INSTALL_REPORT_FAIL=1 \
    run_mcp_configuration "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal \
      --username demo --allow-insecure-http --force >/tmp/rainbond-install-report-failure.out 2>&1

  assert_file_exists "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json"
  assert_file_exists "$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  assert_file_not_exists "$tmpdir/home/.codex/config.toml"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "3"
}

test_enterprise_lookup_failure_does_not_block_installation() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  TEST_FAKE_DETAILS_HTTP_CODE=500 \
    run_mcp_configuration "$tmpdir" claude --non-interactive --rainbond-url http://rainbond.internal \
      --username demo --allow-insecure-http --force >/tmp/rainbond-install-details-failure.out 2>&1

  assert_file_exists "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json"
  assert_file_exists "$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  assert_file_not_exists "$tmpdir/home/.claude.json"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "1"
  python3 - "$tmpdir/logs/install-report.log" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
if [record["phase"] for record in records] != ["started"]:
    raise SystemExit("enterprise lookup failure should leave only started report: {!r}".format(records))
if records[0]["install_client"] != "claude_code":
    raise SystemExit("unexpected install client: {!r}".format(records[0]))
PY
}

test_unhandled_skill_installation_failure_is_reported() {
  local tmpdir source_dir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  source_dir="$tmpdir/source"
  mkdir -p "$tmpdir/home" "$tmpdir/logs" "$source_dir/rainbond-invalid"
  make_fake_commands "$tmpdir/bin"
  cp "$REPO_ROOT/install.sh" "$source_dir/install.sh"

  set +e
  HOME="$tmpdir/home" \
  TEST_LOG_DIR="$tmpdir/logs" \
  PATH="$tmpdir/bin:/usr/bin:/bin" \
  RAINSKILLS_LEGACY_TELEMETRY_ENABLED=1 \
    bash "$source_dir/install.sh" codex --skip-mcp --force \
      >/tmp/rainbond-install-invalid-skill.out 2>&1
  local rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected invalid skill directory to fail installation"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "2"
  python3 - "$tmpdir/logs/install-report.log" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
failed = next((record for record in records if record["phase"] == "failed"), None)
if failed is None:
    raise SystemExit("missing unhandled failure report: {!r}".format(records))
if failed["phase"] != "failed" or failed["failure_stage"] != "skill_installation":
    raise SystemExit("unexpected unhandled failure report: {!r}".format(failed))
if failed["failure_category"] != "skill_installation_failed":
    raise SystemExit("unexpected unhandled failure category: {!r}".format(failed))
PY
}

test_installer_reports_minimal_v2_results() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  run_installer "$tmpdir" codex --skip-mcp --force >/tmp/rainskills-v2-result.out 2>&1
  wait_for_file_line_count "$tmpdir/logs/telemetry-v2.log" "2"

  python3 - "$tmpdir/logs/telemetry-v2.log" <<'PY'
import json
import re
import sys

uuid_pattern = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", re.I)
records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
if sorted(record["event_type"] for record in records) != ["agent_config_result", "install_result"]:
    raise SystemExit("unexpected v2 event types: {!r}".format(records))
install = next(record for record in records if record["event_type"] == "install_result")
agent = next(record for record in records if record["event_type"] == "agent_config_result")
if install["status"] != "success" or install["action"] != "install":
    raise SystemExit("unexpected install result: {!r}".format(install))
if install["os_type"] not in {"darwin", "linux"} or install["os_arch"] not in {"amd64", "arm64", "other", "unknown"}:
    raise SystemExit("unexpected platform fields: {!r}".format(install))
if agent["agent_type"] != "codex" or agent["status"] != "success":
    raise SystemExit("unexpected agent result: {!r}".format(agent))
if install["installation_id"] != agent["installation_id"]:
    raise SystemExit("events do not share installation id")
for key in ("installation_id", "install_attempt_id", "event_id"):
    if not uuid_pattern.match(install[key]):
        raise SystemExit("invalid install UUID {}={!r}".format(key, install[key]))
for forbidden in ("eid", "failure_reason", "prompt", "path", "duration_ms"):
    if any(forbidden in record for record in records):
        raise SystemExit("forbidden field persisted: {}".format(forbidden))
PY

  assert_file_exists "$tmpdir/home/.rainbond/rainskills/telemetry/installation-id"
  assert_file_exists "$tmpdir/home/.rainbond/rainskills/telemetry/configured-agents.json"
  [[ "$(file_mode "$tmpdir/home/.rainbond/rainskills/telemetry/installation-id")" == "600" ]] \
    || fail "installation id must use mode 600"
}

test_v2_reporting_failure_is_queued_and_does_not_block_installation() {
  local tmpdir pending_count
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  TEST_FAKE_V2_REPORT_FAIL=1 \
    run_installer "$tmpdir" codex --skip-mcp --force >/tmp/rainskills-v2-failure.out 2>&1
  wait_for_file_line_count "$tmpdir/logs/telemetry-v2.log" "2"
  pending_count="$(find "$tmpdir/home/.rainbond/rainskills/telemetry/pending-v2" -type f -name '*.json' | wc -l | tr -d ' ')"
  [[ "$pending_count" == "2" ]] || fail "expected two queued v2 events, got $pending_count"
}

test_public_connect_action_is_rejected_before_url_or_configuration_side_effects() {
  local tmpdir output_file
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs" "$tmpdir/bin"
  make_fake_commands "$tmpdir/bin"
  output_file="$tmpdir/connect.out"

  set +e
  run_installer "$tmpdir" connect codex --non-interactive \
    --rainbond-url 'https://user@example.invalid/path?value=fixture#fragment' \
    --token 'fixture' >"$output_file" 2>&1
  local result_code=$?
  set -e

  [[ "$result_code" -ne 0 ]] || fail "expected public install.sh connect to be rejected"
  assert_file_not_exists "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json"
  assert_file_not_exists "$tmpdir/home/.codex/config.toml"
  assert_file_not_exists "$tmpdir/home/.codex/skills"
  assert_file_not_exists "$tmpdir/logs/curl.log"
  assert_not_contains "$output_file" "user@example.invalid"
  assert_not_contains "$output_file" "value=fixture"
}

test_forged_internal_connect_marker_is_rejected_before_all_side_effects() {
  local tmpdir output_file operation_id
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs" "$tmpdir/bin"
  make_fake_commands "$tmpdir/bin"
  ln -s "$(command -v node)" "$tmpdir/bin/node"
  output_file="$tmpdir/connect.out"
  operation_id="1d6754d6-6fb3-4bda-9a04-15c2d261d178"

  set +e
  RAINSKILLS_RUNTIME_CONNECT_COMPLETION=1 \
  RAINSKILLS_RUNTIME_OPERATION_ID="$operation_id" \
    run_installer "$tmpdir" connect codex --self-hosted \
      --rainbond-url https://console.example.com >"$output_file" 2>&1
  local result_code=$?
  set -e

  [[ "$result_code" -ne 0 ]] || fail "expected forged internal connect marker to fail"
  assert_file_not_exists "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json"
  assert_file_not_exists "$tmpdir/home/.codex/config.toml"
  assert_file_not_exists "$tmpdir/logs/curl.log"
}

test_internal_connect_rejects_state_origin_mismatch_before_all_side_effects() {
  local tmpdir output_file operation_id
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs" "$tmpdir/bin"
  make_fake_commands "$tmpdir/bin"
  ln -s "$(command -v node)" "$tmpdir/bin/node"
  output_file="$tmpdir/connect.out"
  operation_id="1d6754d6-6fb3-4bda-9a04-15c2d261d178"
  write_connecting_runtime_state "$tmpdir/home" "$operation_id" codex private \
    https://console.example.com

  set +e
  RAINSKILLS_RUNTIME_CONNECT_COMPLETION=1 \
  RAINSKILLS_RUNTIME_OPERATION_ID="$operation_id" \
    run_installer "$tmpdir" connect codex --self-hosted \
      --rainbond-url https://other.example.com >"$output_file" 2>&1
  local result_code=$?
  set -e

  [[ "$result_code" -ne 0 ]] || fail "expected runtime state origin mismatch to fail"
  assert_file_not_exists "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json"
  assert_file_not_exists "$tmpdir/home/.codex/config.toml"
  assert_file_not_exists "$tmpdir/logs/curl.log"
  assert_not_contains "$output_file" "other.example.com"
}

test_internal_connect_action_accepts_inspected_loopback_and_private_http_only() {
  local origin tmpdir token output_file operation_id
  operation_id="1d6754d6-6fb3-4bda-9a04-15c2d261d178"
  token="$(make_test_jwt 1893456000)"
  for origin in http://127.0.0.1:7070 http://10.0.0.8:7070; do
    tmpdir="$(mktemp -d)"
    mkdir -p "$tmpdir/home" "$tmpdir/logs" "$tmpdir/bin"
    make_fake_commands "$tmpdir/bin"
    make_connect_node_wrapper "$tmpdir/bin"
    write_connecting_runtime_state "$tmpdir/home" "$operation_id" codex private "$origin"
    output_file="$tmpdir/connect.out"

    RAINSKILLS_RUNTIME_CONNECT_COMPLETION=1 \
    RAINSKILLS_RUNTIME_OPERATION_ID="$operation_id" \
    RAINBOND_URL="$origin" \
    RAINBOND_JWT="$token" \
      run_installer "$tmpdir" connect codex --self-hosted \
        --rainbond-url "$origin" --non-interactive >"$output_file" 2>&1

    assert_file_not_exists "$tmpdir/home/.rainbond/mcp.env"
    assert_file_exists "$tmpdir/home/.rainbond/bin/rainskills-tools.js"
    assert_file_not_exists "$tmpdir/home/.codex/config.toml"
    assert_file_not_exists "$tmpdir/home/.codex/skills"
    assert_contains "$tmpdir/logs/node.log" "runtime complete-connect"
    assert_contains "$tmpdir/logs/node.log" "runtime persist-connect-credential"
    assert_not_contains "$output_file" "默认禁用明文 HTTP"
    rm -rf "$tmpdir"
  done
}

test_internal_connect_requires_the_current_rainbond_cli_endpoint() {
  local tmpdir token output_file operation_id origin
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs" "$tmpdir/bin"
  make_fake_commands "$tmpdir/bin"
  make_connect_node_wrapper "$tmpdir/bin"
  operation_id="1d6754d6-6fb3-4bda-9a04-15c2d261d178"
  origin="http://10.0.0.8:7070"
  token="$(make_test_jwt 1893456000)"
  output_file="$tmpdir/connect.out"
  write_connecting_runtime_state "$tmpdir/home" "$operation_id" codex private "$origin"

  TEST_FAKE_MCP_HTTP_CODE=200 \
  RAINSKILLS_RUNTIME_CONNECT_COMPLETION=1 \
  RAINSKILLS_RUNTIME_OPERATION_ID="$operation_id" \
  RAINBOND_URL="$origin" \
  RAINBOND_JWT="$token" \
    run_installer "$tmpdir" connect codex --self-hosted \
      --rainbond-url "$origin" --non-interactive >"$output_file" 2>&1

  assert_contains "$tmpdir/logs/curl.log" "$origin/console/mcp/rainskills/api/query"
  assert_not_contains "$tmpdir/logs/curl.log" "$origin/console/mcp/query"
  assert_contains "$tmpdir/logs/node.log" "runtime complete-connect"
}

