  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  token="$(make_test_jwt 1893456000)"
  output_file="$tmpdir/install.out"

  TEST_FAKE_SPECIALIZED_MCP_HTTP_CODE=404 \
  TEST_FAKE_GENERIC_MCP_HTTP_CODE=200 \
  RAINBOND_JWT="$token" \
    run_mcp_configuration "$tmpdir" codex --non-interactive \
      --rainbond-url http://rainbond.internal --allow-insecure-http --force \
      >"$output_file" 2>&1

  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/mcp/rainskills/codex/query"
  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/mcp/query"
  assert_file_exists "$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  assert_not_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/mcp/rainskills/api/query"
}

