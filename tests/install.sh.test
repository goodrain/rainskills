test_mcp_404_reports_missing_endpoint() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  set +e
  (
    export TEST_FAKE_MCP_HTTP_CODE=404
    run_installer "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force
  ) >/tmp/rainbond-install-404.out 2>&1
  local rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected installer to fail when MCP endpoint returns 404"
  grep -F -- "未暴露 /console/mcp/rainskills/codex/query" /tmp/rainbond-install-404.out >/dev/null || fail "expected missing endpoint guidance"

  wait_for_file_line_count "$tmpdir/logs/install-report.log" "3"
  python3 - "$tmpdir/logs/install-report.log" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
failed = next((record for record in records if record["phase"] == "failed"), None)
if failed is None:
    raise SystemExit("missing failed report: {!r}".format(records))
if failed["phase"] != "failed" or failed["status"] != "failure":
    raise SystemExit("expected final failed report, got {!r}".format(failed))
if failed["failure_stage"] != "verification":
    raise SystemExit("unexpected failure stage: {!r}".format(failed))
if failed["failure_category"] != "mcp_verification_failed":
    raise SystemExit("unexpected failure category: {!r}".format(failed))
if failed["eid"] != "enterprise-test" or failed["install_client"] != "codex":
    raise SystemExit("failure report lost enterprise/client metadata: {!r}".format(failed))
PY
}

test_installer_reports_installation_lifecycle() {
  local tmpdir report_file
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  run_installer "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http --force >/tmp/rainbond-install-report.out 2>&1

  report_file="$tmpdir/logs/install-report.log"
  wait_for_file_line_count "$report_file" "3"
  python3 - "$report_file" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
by_phase = {record["phase"]: record for record in records}
if set(by_phase) != {"started", "authorized", "configured"} or len(records) != 3:
    raise SystemExit("unexpected installation phases: {!r}".format([record["phase"] for record in records]))

attempt_ids = {record["install_attempt_id"] for record in records}
if len(attempt_ids) != 1 or not next(iter(attempt_ids)):
    raise SystemExit("installation reports must share one non-empty attempt id")

started = by_phase["started"]
authorized = by_phase["authorized"]
configured = by_phase["configured"]
if started != {
    "install_attempt_id": started["install_attempt_id"],
    "eid": "",
    "install_client": "codex",
    "action": "install",
    "phase": "started",
    "status": "started",
    "failure_stage": "",
    "failure_category": "",
}:
    raise SystemExit("unexpected started report: {!r}".format(started))

for record, phase in ((authorized, "authorized"), (configured, "configured")):
    if record["eid"] != "enterprise-test":
        raise SystemExit("{} report is missing enterprise id".format(phase))
    if record["install_client"] != "codex" or record["action"] != "install":
        raise SystemExit("unexpected {} metadata: {!r}".format(phase, record))
    if record["status"] != "success":
        raise SystemExit("unexpected {} status: {!r}".format(phase, record))

raw = open(sys.argv[1], encoding="utf-8").read()
for secret_marker in ("GRJWT", "Authorization", ".signature", "secret-password"):
    if secret_marker in raw:
        raise SystemExit("installation report leaked secret marker: {}".format(secret_marker))
PY
}

test_installation_reporting_failures_do_not_block_installation() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  TEST_FAKE_INSTALL_REPORT_FAIL=1 \
    run_installer "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal \
      --username demo --allow-insecure-http --force >/tmp/rainbond-install-report-failure.out 2>&1

  assert_file_exists "$tmpdir/home/.rainbond/mcp.env"
  assert_file_exists "$tmpdir/home/.codex/config.toml"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "3"
}

test_enterprise_lookup_failure_does_not_block_installation() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  TEST_FAKE_DETAILS_HTTP_CODE=500 \
    run_installer "$tmpdir" claude --non-interactive --rainbond-url http://rainbond.internal \
      --username demo --allow-insecure-http --force >/tmp/rainbond-install-details-failure.out 2>&1

  assert_file_exists "$tmpdir/home/.rainbond/mcp.env"
  assert_file_exists "$tmpdir/home/.claude.json"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "1"
  python3 - "$tmpdir/logs/install-report.log" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
if [record["phase"] for record in records] != ["started"]:
    raise SystemExit("enterprise lookup failure should leave only started report: {!r}".format(records))
if records[0]["install_client"] != "claude_code":
    raise SystemExit("unexpected install client: {!r}".format(records[0]))
PY
}

test_unhandled_skill_installation_failure_is_reported() {
  local tmpdir source_dir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  source_dir="$tmpdir/source"
  mkdir -p "$tmpdir/home" "$tmpdir/logs" "$source_dir/rainbond-invalid"
  make_fake_commands "$tmpdir/bin"
  cp "$REPO_ROOT/install.sh" "$source_dir/install.sh"

  set +e
  HOME="$tmpdir/home" \
  TEST_LOG_DIR="$tmpdir/logs" \
  PATH="$tmpdir/bin:/usr/bin:/bin" \
    bash "$source_dir/install.sh" codex --skip-mcp --force \
      >/tmp/rainbond-install-invalid-skill.out 2>&1
  local rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected invalid skill directory to fail installation"
  wait_for_file_line_count "$tmpdir/logs/install-report.log" "2"
  python3 - "$tmpdir/logs/install-report.log" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
failed = next((record for record in records if record["phase"] == "failed"), None)
if failed is None:
    raise SystemExit("missing unhandled failure report: {!r}".format(records))
if failed["phase"] != "failed" or failed["failure_stage"] != "skill_installation":
    raise SystemExit("unexpected unhandled failure report: {!r}".format(failed))
if failed["failure_category"] != "skill_installation_failed":
    raise SystemExit("unexpected unhandled failure category: {!r}".format(failed))
PY
}

test_api_only_installs_bridge_authorizes_and_never_configures_mcp() {
  local target tmpdir custom_dest default_token
  default_token="$(make_test_jwt 1893456000)"
  for target in codex claude pi all; do
    tmpdir="$(mktemp -d)"
    mkdir -p "$tmpdir/home" "$tmpdir/logs"
    make_fake_commands "$tmpdir/bin"
    make_fake_node "$tmpdir/bin"

    run_installer "$tmpdir" "$target" --api-only --non-interactive \
      --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force

    assert_file_exists "$tmpdir/home/.rainbond/bin/rainskills-tools.js"
    [[ "$(file_mode "$tmpdir/home/.rainbond")" == "700" ]] || fail "expected .rainbond mode 700"
    [[ "$(file_mode "$tmpdir/home/.rainbond/bin")" == "700" ]] || fail "expected bridge directory mode 700"
    [[ "$(file_mode "$tmpdir/home/.rainbond/bin/rainskills-tools.js")" == "700" ]] \
      || fail "expected bridge mode 700"
    assert_contains "$tmpdir/home/.rainbond/mcp.env" "export RAINBOND_JWT='$default_token'"
    assert_contains "$tmpdir/logs/curl.log" "/console/mcp/rainskills/api/query"
    assert_contains "$tmpdir/logs/curl.log" "--connect-timeout 10 --max-time 180"
    [[ ! -f "$tmpdir/logs/codex.log" ]] || fail "api-only must not run codex MCP commands"
    [[ ! -f "$tmpdir/logs/claude.log" ]] || fail "api-only must not run claude MCP commands"
    [[ ! -f "$tmpdir/home/.codex/config.toml" ]] || fail "api-only must not edit Codex MCP config"
    [[ ! -f "$tmpdir/home/.claude.json" ]] || fail "api-only must not edit Claude MCP config"
    [[ ! -e "$tmpdir/home/.pi/agent/extensions/rainskills-mcp.ts" ]] \
      || fail "api-only must not install the Pi MCP extension"
    rm -rf "$tmpdir"
  done

  tmpdir="$(mktemp -d)"
  custom_dest="$tmpdir/custom-skills"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  run_installer "$tmpdir" --dest "$custom_dest" --api-only --non-interactive \
    --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force
  assert_file_exists "$custom_dest/rainbond-app-assistant/SKILL.md"
  assert_file_exists "$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  assert_contains "$tmpdir/logs/curl.log" "/console/mcp/rainskills/api/query"
  [[ ! -f "$tmpdir/logs/codex.log" ]] || fail "custom API-only must not run Codex"
  [[ ! -f "$tmpdir/logs/claude.log" ]] || fail "custom API-only must not run Claude"
  rm -rf "$tmpdir"
}

test_api_only_rejects_conflicts_and_missing_node() {
  local tmpdir rc
  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  set +e
  run_installer "$tmpdir" codex --api-only --skip-mcp --force >/tmp/rainskills-api-conflict.out 2>&1
  rc=$?
  set -e
  [[ $rc -ne 0 ]] || fail "expected --api-only/--skip-mcp conflict"
  grep -F -- "--api-only" /tmp/rainskills-api-conflict.out >/dev/null || fail "expected conflict guidance"

  set +e
  run_installer "$tmpdir" codex --api-only --non-interactive --saas --force \
    >/tmp/rainskills-api-node.out 2>&1
  rc=$?
  set -e
  [[ $rc -ne 0 ]] || fail "expected API-only to require Node 18+"
  grep -F -- "Node.js 18" /tmp/rainskills-api-node.out >/dev/null || fail "expected Node 18 guidance"
  [[ ! -e "$tmpdir/home/.rainbond/bin/rainskills-tools.js" ]] || fail "failed preflight must not install bridge"
  rm -rf "$tmpdir"
}

test_bridge_modes_preserve_legacy_install_semantics_and_refresh() {
  local tmpdir custom_dest bridge sentinel rc
  tmpdir="$(mktemp -d)"
  custom_dest="$tmpdir/custom-skills"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  run_installer "$tmpdir" codex --skip-mcp --force
  [[ ! -e "$tmpdir/home/.rainbond/bin/rainskills-tools.js" ]] || fail "skip-mcp must remain skill-copy-only"
  run_installer "$tmpdir" --dest "$custom_dest" --force
  [[ ! -e "$tmpdir/home/.rainbond/bin/rainskills-tools.js" ]] || fail "custom dest alone must remain skill-copy-only"

  TEST_FAKE_CODEX_ADD_FAIL=1 run_installer "$tmpdir" codex --non-interactive \
    --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
    >/tmp/rainskills-default-mcp-failure.out 2>&1 && rc=0 || rc=$?
  [[ $rc -eq 0 ]] || fail "default install must fall back when MCP registration fails"
  assert_contains /tmp/rainskills-default-mcp-failure.out "API Bridge 回退"
  assert_contains "$tmpdir/logs/curl.log" "/console/mcp/rainskills/api/query"
  bridge="$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  assert_file_exists "$bridge"

  sentinel='refresh-must-not-replace-this-bridge'
  printf '%s\n' "$sentinel" >"$bridge"
  chmod 700 "$bridge"
  run_installer "$tmpdir" refresh --non-interactive --self-hosted --username demo \
    --rainbond-url http://rainbond.internal --allow-insecure-http
  assert_contains "$bridge" "$sentinel"
  rm -rf "$tmpdir"
}

test_default_install_uses_environment_url_and_automatic_api_fallback() {
  local tmpdir rc token
  token="$(make_test_jwt 1893456000)"

  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  RAINBOND_URL=http://rainbond.internal run_installer "$tmpdir" codex --non-interactive \
    --username demo --allow-insecure-http --force >/tmp/rainskills-env-url.out 2>&1
  assert_contains "$tmpdir/home/.rainbond/mcp.env" "export RAINBOND_URL='http://rainbond.internal'"
  assert_not_contains /tmp/rainskills-env-url.out "非交互私有化部署必须提供 --rainbond-url"
  assert_not_contains /tmp/rainskills-env-url.out "Rainbond Console 地址:"
  rm -rf "$tmpdir"

  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  TEST_FAKE_MCP_HTTP_CODE=404 TEST_FAKE_API_HTTP_CODE=200 \
    run_installer "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal \
      --username demo --allow-insecure-http --force >/tmp/rainskills-mcp-api-fallback.out 2>&1
  assert_contains /tmp/rainskills-mcp-api-fallback.out "API Bridge 回退"
  assert_contains /tmp/rainskills-mcp-api-fallback.out "当前会话无 Rainbond MCP 时会自动使用 API Bridge"
  assert_contains "$tmpdir/logs/curl.log" "/console/mcp/rainskills/codex/query"
  assert_contains "$tmpdir/logs/curl.log" "/console/mcp/rainskills/api/query"
  [[ ! -f "$tmpdir/logs/codex.log" ]] || fail "failed MCP verification must not configure Codex"
  rm -rf "$tmpdir"

  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  set +e
  TEST_FAKE_MCP_HTTP_CODE=404 TEST_FAKE_API_HTTP_CODE=503 \
    run_installer "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal \
      --username demo --allow-insecure-http --force >/tmp/rainskills-dual-transport-failure.out 2>&1
  rc=$?
  set -e
  [[ $rc -ne 0 ]] || fail "both MCP and API failures must fail installation"
  assert_contains /tmp/rainskills-dual-transport-failure.out "原生 MCP"
  assert_contains /tmp/rainskills-dual-transport-failure.out "API Bridge"
  assert_not_contains /tmp/rainskills-dual-transport-failure.out "$token"
  [[ ! -e "$tmpdir/home/.rainbond/mcp.env" ]] || fail "dual transport failure must not persist new credentials"
  rm -rf "$tmpdir"

  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  TEST_FAKE_CLAUDE_ADD_FAIL=1 run_installer "$tmpdir" all --non-interactive \
    --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
    >/tmp/rainskills-partial-mcp-fallback.out 2>&1
  assert_file_exists "$tmpdir/home/.codex/config.toml"
  assert_contains /tmp/rainskills-partial-mcp-fallback.out "API Bridge 回退"
  assert_contains "$tmpdir/logs/curl.log" "/console/mcp/rainskills/api/query"
  rm -rf "$tmpdir"

  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  set +e
  TEST_FAKE_MCP_HTTP_CODE=404 run_installer "$tmpdir" codex --non-interactive \
    --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
    >/tmp/rainskills-no-node-fallback.out 2>&1
  rc=$?
  set -e
  [[ $rc -ne 0 ]] || fail "MCP failure without Node 18 must remain fatal"
  assert_contains /tmp/rainskills-no-node-fallback.out "Node.js 18"
  rm -rf "$tmpdir"
}

test_bridge_install_replaces_updates_and_rejects_symlink_targets() {
  local tmpdir bridge rc
  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"

  run_installer "$tmpdir" codex --api-only --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http --force
  bridge="$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  printf 'stale\n' >"$bridge"
  run_installer "$tmpdir" codex --api-only --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http
  assert_not_contains "$bridge" "stale"

  rm -rf "$tmpdir/home/.rainbond/bin"
  ln -s "$tmpdir/logs" "$tmpdir/home/.rainbond/bin"
  set +e
  run_installer "$tmpdir" codex --api-only --non-interactive --rainbond-url http://rainbond.internal \
    --username demo --allow-insecure-http --force >/tmp/rainskills-bridge-symlink.out 2>&1
  rc=$?
  set -e
  [[ $rc -ne 0 ]] || fail "expected symlink bridge directory rejection"
  [[ ! -e "$tmpdir/logs/rainskills-tools.js" ]] || fail "must not write through bridge directory symlink"
  [[ -z "$(find "$tmpdir/home/.rainbond" -maxdepth 1 -name '.bin.rainskills-*' -print -quit)" ]] \
    || fail "temporary bridge paths must be cleaned"
  rm -rf "$tmpdir"
}

test_bridge_install_failures_preserve_old_target_and_clean_staging() {
  local stage tmpdir bridge rc
  for stage in cp chmod mv; do
    tmpdir="$(mktemp -d)"
    mkdir -p "$tmpdir/home/.rainbond/bin" "$tmpdir/logs"
    make_fake_commands "$tmpdir/bin"
    make_fake_node "$tmpdir/bin"
    make_faulty_file_command "$tmpdir/bin" cp /bin/cp
    make_faulty_file_command "$tmpdir/bin" chmod /bin/chmod
    make_faulty_file_command "$tmpdir/bin" mv /bin/mv
    bridge="$tmpdir/home/.rainbond/bin/rainskills-tools.js"
    printf 'old-bridge\n' >"$bridge"
    /bin/chmod 700 "$tmpdir/home/.rainbond" "$tmpdir/home/.rainbond/bin" "$bridge"

    set +e
    TEST_FAIL_BRIDGE_STAGE="$stage" run_installer "$tmpdir" codex --api-only --non-interactive \
      --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
      >/tmp/rainskills-bridge-${stage}-failure.out 2>&1
    rc=$?
    set -e
    [[ $rc -ne 0 ]] || fail "expected bridge $stage failure"
    assert_contains "$bridge" "old-bridge"
    [[ -z "$(find "$tmpdir/home/.rainbond/bin" -maxdepth 1 \
      \( -name '.rainskills-tools.js.*' -o -name '.rainskills-tools.js.backup.*' \) -print -quit)" ]] \
      || fail "bridge $stage failure must clean staging files"
    rm -rf "$tmpdir"
  done
}

test_bridge_signal_cleanup_preserves_old_target() {
  local tmpdir bridge rc
  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home/.rainbond/bin" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  make_fake_node "$tmpdir/bin"
  make_faulty_file_command "$tmpdir/bin" cp /bin/cp
  bridge="$tmpdir/home/.rainbond/bin/rainskills-tools.js"
  printf 'old-bridge\n' >"$bridge"
  /bin/chmod 700 "$tmpdir/home/.rainbond" "$tmpdir/home/.rainbond/bin" "$bridge"
  set +e
  TEST_FAIL_BRIDGE_STAGE=signal run_installer "$tmpdir" codex --api-only --non-interactive \
    --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
    >/tmp/rainskills-bridge-signal.out 2>&1
  rc=$?
  set -e
  [[ $rc -eq 143 ]] || fail "expected SIGTERM cleanup exit 143, got $rc"
  assert_contains "$bridge" "old-bridge"
  [[ -z "$(find "$tmpdir/home/.rainbond/bin" -maxdepth 1 -name '.rainskills-tools.js.*' -print -quit)" ]] \
    || fail "SIGTERM must clean bridge staging file"
  rm -rf "$tmpdir"
}

