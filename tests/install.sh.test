test_refresh_rewrites_the_single_runtime_without_client_mcp_changes() {
  local tmpdir expired_token fresh_token
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home/.rainbond/rainskills" "$tmpdir/home/.codex" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  expired_token="$(make_test_jwt 1700000000)"
  fresh_token="$(make_test_jwt 1893456000)"
  cat > "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json" <<EOF
{
  "schema": "rainskills.single-runtime.v1",
  "version": 1,
  "console_origin": "http://rainbond.internal",
  "kind": "private",
  "token": "$expired_token",
  "allow_insecure_http": true,
  "created_at": "2026-08-26T00:00:00.000Z",
  "updated_at": "2026-08-26T00:00:00.000Z"
}
EOF
  chmod 600 "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json"
  cat > "$tmpdir/home/.codex/config.toml" <<'EOF'
[mcp_servers.keep]
url = "https://keep.example/mcp"
EOF

  TEST_FAKE_LOGIN_TOKEN="$fresh_token" \
    run_installer "$tmpdir" refresh --non-interactive --self-hosted --username demo --allow-insecure-http \
    >/tmp/rainbond-install-refresh.out 2>&1

  assert_contains "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json" "$fresh_token"
  assert_contains "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json" '"console_origin": "http://rainbond.internal"'
  [[ "$(file_mode "$tmpdir/home/.rainbond/rainskills/single-runtime-v1.json")" == "600" ]] \
    || fail "refresh should keep single runtime permissions at 600"
  assert_contains "$tmpdir/home/.codex/config.toml" "https://keep.example/mcp"
  assert_file_not_exists "$tmpdir/home/.zshrc"
  grep -F -- "使用单运行环境中已记录的地址" /tmp/rainbond-install-refresh.out >/dev/null \
    || fail "expected refresh to reuse the single runtime origin"
}

test_mcp_404_reports_missing_endpoint() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  set +e
  (
    export TEST_FAKE_MCP_HTTP_CODE=404
    run_mcp_configuration "$tmpdir" codex --non-interactive --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force
  ) >/tmp/rainbond-install-404.out 2>&1
  local rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected installer to fail when MCP endpoint returns 404"
  grep -F -- "请先将 Rainbond 升级到 v6.9.9 或更高版本" /tmp/rainbond-install-404.out >/dev/null || fail "expected upgrade guidance"
  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/mcp/rainskills/api/query"
  assert_not_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/mcp/query"

  wait_for_file_line_count "$tmpdir/logs/install-report.log" "3"
  python3 - "$tmpdir/logs/install-report.log" <<'PY'
import json
import sys

records = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
failed = next((record for record in records if record["phase"] == "failed"), None)
if failed is None:
    raise SystemExit("missing failed report: {!r}".format(records))
if failed["phase"] != "failed" or failed["status"] != "failure":
    raise SystemExit("expected final failed report, got {!r}".format(failed))
if failed["failure_stage"] != "verification":
    raise SystemExit("unexpected failure stage: {!r}".format(failed))
if failed["failure_category"] != "mcp_verification_failed":
    raise SystemExit("unexpected failure category: {!r}".format(failed))
if failed["eid"] != "enterprise-test" or failed["install_client"] != "codex":
    raise SystemExit("failure report lost enterprise/client metadata: {!r}".format(failed))
PY
}

test_old_rainbond_falls_back_to_generic_mcp_endpoint() {
  local tmpdir token output_file
  tmpdir="$(mktemp -d)"
