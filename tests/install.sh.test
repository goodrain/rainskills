test_interactive_prompts_are_visible() {
  local tmpdir
  local output_file
  tmpdir="$(mktemp -d)"
  output_file="$tmpdir/interactive.out"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  if ! run_interactive_installer_with_pty "$tmpdir" "$output_file"; then
    printf 'interactive installer output:\n' >&2
    tail -n 120 "$output_file" >&2 || true
    return 1
  fi

  assert_contains "$output_file" "RainSkills 文件已安装完成。"
  assert_contains "$output_file" "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_connection]"
  assert_occurrence_count "$output_file" "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_connection]" "1"
  assert_contains "$output_file" "请选择要连接的 Rainbond："
  assert_contains "$output_file" "1) Rainbond Cloud"
  assert_contains "$output_file" "无需自行安装 Rainbond，登录后即可使用"
  assert_contains "$output_file" "2) 私有化部署"
  assert_contains "$output_file" "你现在是否已经有可以访问的 Rainbond 平台？"
  assert_contains "$output_file" "1) 已经有，填写平台地址"
  assert_contains "$output_file" "2) 还没有，帮我安装"
  assert_contains "$output_file" "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_console_url]"
  assert_occurrence_count "$output_file" "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_console_url]" "1"
  assert_contains "$output_file" "请发送浏览器中访问 Rainbond 控制台的完整地址，例如："
  assert_contains "$output_file" "https://rainbond.example.com"
  assert_contains "$output_file" "Rainbond Console 地址: "
  assert_contains "$output_file" "Rainbond 用户名: "
  assert_not_contains "$output_file" "Rainbond 平台安装将在独立步骤中继续"
  assert_contains "$output_file" "请输入 1 或 2。"
  assert_not_contains "$output_file" "回车默认 1"
  assert_appears_before "$output_file" \
    "RainSkills 文件已安装完成。" \
    "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_connection]"
  assert_appears_before "$output_file" \
    "请输入选项 [1-2]: " \
    "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_console_url]"
  assert_appears_before "$output_file" \
    "[RAINSKILLS_USER_INPUT_REQUIRED:rainbond_console_url]" \
    "Rainbond Console 地址: "
}

test_private_install_branch_writes_checkpoint_and_returns_fixed_next_action() {
  local tmpdir output_file state_file
  tmpdir="$(mktemp -d)"
  output_file="$tmpdir/no-platform.out"
  state_file="$tmpdir/home/.rainbond/rainskills-onboarding-v1.json"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  run_interactive_no_platform_with_pty "$tmpdir" "$output_file"

  assert_file_exists "$state_file"
  [[ "$(file_mode "$state_file")" == "600" ]] || fail "expected onboarding state permissions to be 600"
  assert_contains "$output_file" "Rainbond 平台安装将在独立步骤中继续"
  assert_contains "$output_file" "npx rainskills@0.1.0-rc.3 platform install --onboarding-id"
  assert_contains "$output_file" '"schema":"rainskills.next-action.v1"'
  assert_contains "$output_file" '"action":"install-platform"'
  assert_not_contains "$output_file" "Rainbond Console 地址: "

  python3 - "$state_file" "$output_file" <<'PY'
import json
import sys

state_path, output_path = sys.argv[1:]
state = json.load(open(state_path, encoding="utf-8"))
assert state["schema"] == "rainskills.onboarding.v1"
assert state["version"] == 1
assert state["stage"] == "awaiting-platform"
assert state["target"] == "codex"
assert state["deployment_mode"] == "self-hosted"
assert state["console_url"] is None

lines = open(output_path, encoding="utf-8", errors="replace").read().splitlines()
markers = [json.loads(line) for line in lines if line.startswith('{"schema":"rainskills.next-action.v1"')]
assert len(markers) == 1
marker = markers[0]
assert marker["onboarding_id"] == state["operation_id"]
assert marker["argv"] == ["platform", "install", "--onboarding-id", state["operation_id"]]
PY
}

