#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEST_SUITE_REAL_NODE="$(command -v node)"
CURRENT_PACKAGE_VERSION="$(node -p 'require(process.argv[1]).version' "$REPO_ROOT/package.json")"
unset RAINBOND_JWT RAINBOND_URL RAINBOND_USERNAME RAINBOND_PASSWORD

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

assert_file_exists() {
  local path="$1"
  [[ -f "$path" ]] || fail "expected file to exist: $path"
}

assert_file_not_exists() {
  local path="$1"
  [[ ! -e "$path" ]] || fail "did not expect path to exist: $path"
}

assert_contains() {
  local path="$1"
  local pattern="$2"
  grep -F -- "$pattern" "$path" >/dev/null || fail "expected '$pattern' in $path"
}

assert_not_contains() {
  local path="$1"
  local pattern="$2"
  if grep -F -- "$pattern" "$path" >/dev/null; then
    fail "did not expect '$pattern' in $path"
  fi
}

assert_line_count() {
  local path="$1"
  local pattern="$2"
  local expected="$3"
  local count
  count="$(grep -Fxc -- "$pattern" "$path" || true)"
  [[ "$count" == "$expected" ]] || fail "expected '$pattern' to appear $expected times in $path, got $count"
}

assert_occurrence_count() {
  local path="$1"
  local pattern="$2"
  local expected="$3"
  python3 - "$path" "$pattern" "$expected" <<'PY'
import sys

path, pattern, expected = sys.argv[1], sys.argv[2], int(sys.argv[3])
with open(path, encoding="utf-8", errors="replace") as fh:
    count = fh.read().count(pattern)
if count != expected:
    raise SystemExit(
        "expected {!r} to appear {} times in {}, got {}".format(
            pattern, expected, path, count
        )
    )
PY
}

assert_appears_before() {
  local path="$1"
  local first="$2"
  local second="$3"
  python3 - "$path" "$first" "$second" <<'PY'
import sys

path, first, second = sys.argv[1:4]
with open(path, encoding="utf-8", errors="replace") as fh:
    content = fh.read()

first_index = content.find(first)
second_index = content.find(second)
if first_index < 0 or second_index < 0 or first_index >= second_index:
    raise SystemExit("expected {!r} before {!r}".format(first, second))
PY
}

assert_exact_capability_summary() {
  local path="$1"
  python3 - "$path" <<'PY'
import sys

path = sys.argv[1]
expected = """Rainskills 安装完成，下一条消息即可直接使用。

下一步可以直接说：

- 帮我部署当前项目
- 帮我部署一个 Git 仓库
- 帮我通过镜像或安装包部署应用
- 帮我安装一个应用模板
- 帮我分析当前项目应该如何部署

也可以直接告诉我你想部署什么应用。"""
content = open(path, encoding="utf-8", errors="replace").read().replace("\r", "")
if content.count(expected) != 1:
    raise SystemExit("expected the approved capability summary exactly once")
framed = "[RAINSKILLS_USER_MESSAGE_BEGIN:install.completed]\n{}\n[RAINSKILLS_USER_MESSAGE_END:install.completed]".format(expected)
summary_requirement = "[RAINSKILLS_AGENT_SUMMARY_REQUIRED:include-next-actions]"
if content.strip() != "{}\n{}".format(framed, summary_requirement):
    raise SystemExit("default Skills-only output must contain only the bounded next-action summary contract: {!r}".format(content))
if content.count(summary_requirement) != 1:
    raise SystemExit("missing agent summary next-action requirement")
for forbidden in ("reload", "restart", "重新加载", "重启"):
    if forbidden in content.lower():
        raise SystemExit("skills-only completion contains forbidden guidance: {}".format(forbidden))
start = content.index("下一步可以直接说：")
end = content.index("也可以直接告诉我你想部署什么应用。", start)
actual_bullets = [line for line in content[start:end].splitlines() if line.startswith("- ")]
expected_bullets = [line for line in expected.splitlines() if line.startswith("- ")]
if actual_bullets != expected_bullets:
    raise SystemExit("capability list differs: {!r}".format(actual_bullets))
PY
}

wait_for_file_line_count() {
  local path="$1"
  local expected="$2"
  local attempt count
  for ((attempt = 0; attempt < 100; attempt++)); do
    if [[ -f "$path" ]]; then
      count="$(wc -l < "$path" | tr -d ' ')"
    else
      count="0"
    fi
    if [[ "$count" == "$expected" ]]; then
      return 0
    fi
    sleep 0.02
  done
  fail "expected $expected lines in $path, got ${count:-0}"
}

file_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

make_test_jwt() {
  local exp="$1"
  python3 - "$exp" <<'PY'
import base64
import json
import sys

exp = int(sys.argv[1])

def b64(payload):
    raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")

print("{}.{}.signature".format(
    b64({"alg": "HS256", "typ": "JWT"}),
    b64({"sub": "demo", "exp": exp}),
))
PY
}

write_connecting_runtime_state() {
  local home="$1" operation_id="$2" target="$3" environment_kind="$4" origin="$5"
  python3 - "$home" "$operation_id" "$target" "$environment_kind" "$origin" <<'PY'
import json
import os
import sys

home, operation_id, target, environment_kind, origin = sys.argv[1:]
directory = os.path.join(home, ".rainbond", "rainskills")
os.makedirs(directory, mode=0o700, exist_ok=True)
os.chmod(os.path.join(home, ".rainbond"), 0o700)
os.chmod(directory, 0o700)
state = {
    "schema": "rainskills.runtime-connection.v1",
    "version": 1,
    "state": "connecting",
    "target_client": target,
    "environment_kind": environment_kind,
    "console_origin": origin,
    "operation_id": operation_id,
    "validated_probe_at": None,
    "created_at": "2026-08-14T00:00:00.000Z",
    "updated_at": "2026-08-14T00:00:00.000Z",
}
path = os.path.join(directory, "runtime-connection-v1.json")
with open(path, "w", encoding="utf-8") as stream:
    json.dump(state, stream)
    stream.write("\n")
os.chmod(path, 0o600)
PY
}

make_connect_node_wrapper() {
  local bin_dir="$1"
  cat >"$bin_dir/node" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == */scripts/install-local-cli.mjs ]]; then
  exec "$TEST_REAL_NODE" "$@"
fi
case "${3:-}" in
  assert-connect)
    exec "$TEST_REAL_NODE" "$@"
    ;;
  persist-connect-credential)
    printf 'runtime persist-connect-credential\n' >> "${TEST_LOG_DIR}/node.log"
    ;;
  complete-connect)
    printf 'runtime complete-connect\n' >> "${TEST_LOG_DIR}/node.log"
    ;;
  *)
    exit 64
    ;;
esac
EOF
  chmod +x "$bin_dir/node"
}

make_fake_commands() {
  local bin_dir="$1"
  mkdir -p "$bin_dir"

  cat >"$bin_dir/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "${TEST_LOG_DIR}/codex.log"
if [[ "${1:-}" == "mcp" && "${2:-}" == "add" ]]; then
  if [[ "${TEST_FAKE_CODEX_ADD_FAIL:-}" == "1" ]]; then
    exit 1
  fi
  name="${3:-}"
  shift 3
  url=""
  env_var=""
  command=""
  command_args=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --url)
        url="$2"
        shift 2
        ;;
      --bearer-token-env-var)
        env_var="$2"
        shift 2
        ;;
      --)
        shift
        command="${1:-}"
        shift || true
        command_args="$*"
        break
        ;;
      *)
        shift
        ;;
    esac
  done
  mkdir -p "$HOME/.codex"
  if [[ -n "$command" ]]; then
    python3 - "$HOME/.codex/config.toml" "$name" "$command" $command_args <<'PY'
import json
import sys
path, name, command, *args = sys.argv[1:]
with open(path, "w", encoding="utf-8") as output:
    output.write("[mcp_servers.{}]\n".format(name))
    output.write("command = {}\n".format(json.dumps(command)))
    output.write("args = {}\n".format(json.dumps(args)))
PY
  else
    cat > "$HOME/.codex/config.toml" <<CONFIG
[mcp_servers.${name}]
url = "${url}"
bearer_token_env_var = "${env_var}"
CONFIG
  fi
  exit 0
fi
echo "unsupported fake codex command: $*" >&2
exit 1
EOF

  cat >"$bin_dir/claude" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "${TEST_LOG_DIR}/claude.log"
if [[ "${1:-}" == "mcp" && "${2:-}" == "add" ]]; then
  shift 2
  scope="local"
  transport=""
  header=""
  name=""
  url=""
  command=""
  command_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --scope)
        scope="$2"
        shift 2
        ;;
      --transport)
        transport="$2"
        shift 2
        ;;
      -H|--header)
        header="$2"
        shift 2
        ;;
      --)
        shift
        command="${1:-}"
        shift || true
        command_args=("$@")
        break
        ;;
      http://*|https://*)
        url="$1"
        shift
        ;;
      *)
        if [[ -z "$name" ]]; then
          name="$1"
        fi
        shift
        ;;
    esac
  done
  mkdir -p "$HOME"
  if [[ -n "$command" ]]; then
    python3 - "$HOME/.claude.json" "$name" "$command" "${command_args[@]}" <<'PY'
import json
import sys
path, name, command, *args = sys.argv[1:]
with open(path, "w", encoding="utf-8") as output:
    json.dump({"mcpServers": {name: {"type": "stdio", "command": command, "args": args}}}, output)
PY
  else
    auth_value="${header#Authorization: }"
    cat > "$HOME/.claude.json" <<CONFIG
{
  "mcpServers": {
    "${name}": {
      "type": "${transport}",
      "url": "${url}",
      "headers": {
        "Authorization": "${auth_value}"
      }
    }
  }
}
CONFIG
  fi
  exit 0
fi
echo "unsupported fake claude command: $*" >&2
exit 1
EOF

  cat >"$bin_dir/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "${TEST_LOG_DIR}/curl.log"

output_file=""
header_file=""
write_out=""
request_data=""
url=""
args=("$@")
i=0
while [[ $i -lt ${#args[@]} ]]; do
  arg="${args[$i]}"
  case "$arg" in
    --output)
      i=$((i + 1))
      output_file="${args[$i]}"
      ;;
    --dump-header)
      i=$((i + 1))
      header_file="${args[$i]}"
      ;;
    --write-out)
      i=$((i + 1))
      write_out="${args[$i]}"
      ;;
    --data|--data-binary)
      i=$((i + 1))
      request_data="${args[$i]}"
      ;;
    http://*|https://*)
      url="$arg"
      ;;
  esac
  i=$((i + 1))
done

body='{}'
if [[ "$url" == "https://log.rainbond.com/api/rainskills/events" ]]; then
  printf '%s\n' "$request_data" >> "${TEST_LOG_DIR}/telemetry-v2.log"
  if [[ "${TEST_FAKE_V2_REPORT_FAIL:-}" == "1" ]]; then
    exit 22
  fi
  body='{"status":"success"}'
elif [[ "$url" == "https://log.rainbond.com/api/rainskills/installations" ]]; then
  printf '%s\n' "$request_data" >> "${TEST_LOG_DIR}/install-report.log"
  if [[ "${TEST_FAKE_INSTALL_REPORT_FAIL:-}" == "1" ]]; then
    exit 22
  fi
  body='{"status":"success"}'
elif [[ "$url" == *"/console/users/details" ]]; then
  if [[ -n "${TEST_FAKE_DETAILS_HTTP_CODE:-}" && "${TEST_FAKE_DETAILS_HTTP_CODE}" != "200" ]]; then
    body='{"code":500,"msg":"details unavailable"}'
  else
    body='{"code":200,"data":{"bean":{"enterprise_id":"enterprise-test"}}}'
  fi
elif [[ "$url" == *"/console/users/login" ]]; then
  login_token="${TEST_FAKE_LOGIN_TOKEN:-}"
  if [[ -z "$login_token" ]]; then
    login_token="$(
      python3 - <<'PY'
import base64
import json

def b64(payload):
    raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")

print("{}.{}.signature".format(
    b64({"alg": "HS256", "typ": "JWT"}),
    b64({"sub": "demo", "exp": 1893456000}),
))
PY
    )"
  fi
  body="{\"code\":200,\"data\":{\"bean\":{\"token\":\"${login_token}\"}}}"
elif [[ "$url" == *"/console/mcp/device/code" ]]; then
  body='Not Found'
elif [[ "$url" == *"/console/mcp/query" || "$url" == *"/console/mcp/rainskills/codex/query" || "$url" == *"/console/mcp/rainskills/claude-code/query" || "$url" == *"/console/mcp/rainskills/api/query" ]]; then
  mcp_http_code="${TEST_FAKE_MCP_HTTP_CODE:-200}"
  if [[ "$url" == *"/console/mcp/query" ]]; then
    mcp_http_code="${TEST_FAKE_GENERIC_MCP_HTTP_CODE:-$mcp_http_code}"
  else
    mcp_http_code="${TEST_FAKE_SPECIALIZED_MCP_HTTP_CODE:-$mcp_http_code}"
  fi
  if [[ "$mcp_http_code" != "200" ]]; then
    body='{"code":404,"msg":"not found"}'
  else
    body='{"jsonrpc":"2.0","id":1,"result":{"serverInfo":{"name":"rainbond-console-mcp"}}}'
  fi
else
  body='{"code":404}'
fi

if [[ -n "$header_file" ]]; then
  {
    if [[ "$url" == *"/console/mcp/device/code" ]]; then
      printf 'HTTP/1.1 404 Not Found\r\n'
      printf 'Content-Type: text/plain\r\n'
    else
      printf 'HTTP/1.1 200 OK\r\n'
      printf 'Content-Type: application/json\r\n'
    fi
    if [[ -n "${TEST_FAKE_RENEWED_TOKEN:-}" ]]; then
      printf 'X-Renewed-Token: %s\r\n' "${TEST_FAKE_RENEWED_TOKEN}"
      printf 'Authorization: GRJWT %s\r\n' "${TEST_FAKE_RENEWED_TOKEN}"
    fi
    printf '\r\n'
  } > "$header_file"
fi

if [[ -n "$output_file" ]]; then
  printf '%s' "$body" > "$output_file"
else
  printf '%s' "$body"
fi

if [[ "$write_out" == "%{http_code}" ]]; then
  if [[ "$url" == *"/console/mcp/device/code" ]]; then
    printf '404'
  elif [[ "$url" == *"/console/mcp/rainskills/"*"/query" && -n "${TEST_FAKE_SPECIALIZED_MCP_HTTP_CODE:-}" ]]; then
    printf '%s' "$TEST_FAKE_SPECIALIZED_MCP_HTTP_CODE"
  elif [[ "$url" == *"/console/mcp/query" && -n "${TEST_FAKE_GENERIC_MCP_HTTP_CODE:-}" ]]; then
    printf '%s' "$TEST_FAKE_GENERIC_MCP_HTTP_CODE"
  elif [[ "$url" == *"/console/mcp/"*"query" && -n "${TEST_FAKE_MCP_HTTP_CODE:-}" ]]; then
    printf '%s' "$TEST_FAKE_MCP_HTTP_CODE"
  elif [[ "$url" == *"/console/users/details" && -n "${TEST_FAKE_DETAILS_HTTP_CODE:-}" ]]; then
    printf '%s' "$TEST_FAKE_DETAILS_HTTP_CODE"
  else
    printf '200'
  fi
fi
EOF

  chmod +x "$bin_dir/codex" "$bin_dir/claude" "$bin_dir/curl"
}

run_installer() {
  local workdir="$1"
  shift
  (
    cd "$REPO_ROOT"
    if [[ "${TEST_RAINBOND_PASSWORD+x}" == "x" ]]; then
      export RAINBOND_PASSWORD="$TEST_RAINBOND_PASSWORD"
    else
      export RAINBOND_PASSWORD="secret-password"
    fi
    HOME="$workdir/home" \
    DSH_HOME="${TEST_DSH_HOME:-$workdir/home/.dsh}" \
    WORKBUDDY_CONFIG_DIR="${TEST_WORKBUDDY_CONFIG_DIR:-$workdir/home/.workbuddy-ai}" \
    SHELL="/bin/zsh" \
    TEST_LOG_DIR="$workdir/logs" \
    PATH="$workdir/bin:$(dirname "$TEST_SUITE_REAL_NODE"):/usr/bin:/bin" \
    TEST_FAKE_MCP_HTTP_CODE="${TEST_FAKE_MCP_HTTP_CODE:-}" \
    TEST_FAKE_LOGIN_TOKEN="${TEST_FAKE_LOGIN_TOKEN:-}" \
    TEST_FAKE_RENEWED_TOKEN="${TEST_FAKE_RENEWED_TOKEN:-}" \
    TEST_FAKE_CODEX_ADD_FAIL="${TEST_FAKE_CODEX_ADD_FAIL:-}" \
    TEST_FAKE_INSTALL_REPORT_FAIL="${TEST_FAKE_INSTALL_REPORT_FAIL:-}" \
    TEST_FAKE_DETAILS_HTTP_CODE="${TEST_FAKE_DETAILS_HTTP_CODE:-}" \
    TEST_FAKE_V2_REPORT_FAIL="${TEST_FAKE_V2_REPORT_FAIL:-}" \
    RAINSKILLS_LEGACY_TELEMETRY_ENABLED=1 \
    TEST_REAL_NODE="$TEST_SUITE_REAL_NODE" \
    bash "$REPO_ROOT/install.sh" "$@"
  )
}

run_mcp_configuration() {
  local workdir="$1"
  shift
  (
    cd "$REPO_ROOT"
    if [[ "${TEST_RAINBOND_PASSWORD+x}" == "x" ]]; then
      export RAINBOND_PASSWORD="$TEST_RAINBOND_PASSWORD"
    else
      export RAINBOND_PASSWORD="secret-password"
    fi
    HOME="$workdir/home" \
    SHELL="/bin/zsh" \
    TEST_LOG_DIR="$workdir/logs" \
      PATH="$workdir/bin:$(dirname "$TEST_SUITE_REAL_NODE"):/usr/bin:/bin" \
    TEST_FAKE_MCP_HTTP_CODE="${TEST_FAKE_MCP_HTTP_CODE:-}" \
    TEST_FAKE_LOGIN_TOKEN="${TEST_FAKE_LOGIN_TOKEN:-}" \
    TEST_FAKE_RENEWED_TOKEN="${TEST_FAKE_RENEWED_TOKEN:-}" \
    TEST_FAKE_CODEX_ADD_FAIL="${TEST_FAKE_CODEX_ADD_FAIL:-}" \
    TEST_FAKE_INSTALL_REPORT_FAIL="${TEST_FAKE_INSTALL_REPORT_FAIL:-}" \
    TEST_FAKE_DETAILS_HTTP_CODE="${TEST_FAKE_DETAILS_HTTP_CODE:-}" \
      RAINSKILLS_LEGACY_TELEMETRY_ENABLED=1 \
      bash -s -- "$REPO_ROOT" "$@" <<'BASH'
set -euo pipefail
repo_root="$1"
shift
source "$repo_root/install.sh" --dest "$HOME/source-probe" --force
trap 'handle_installer_signal 130' INT
trap 'handle_installer_signal 143' TERM
trap 'status=$?; trap - EXIT; handle_installer_exit "$status"; wait || true; exit "$status"' EXIT
initialize_rainskills_installation_reporting "$@"
parse_args "$@"
resolve_target
RAINSKILLS_INSTALL_CLIENT="$(rainskills_install_client_for_target "$TARGET")"
configure_mcp
wait || true
BASH
  )
}

run_interactive_installer_with_pty() {
  local workdir="$1"
  local output_file="$2"
  python3 - "$REPO_ROOT" "$workdir" "$output_file" <<'PY'
import os
import pty
import select
import sys
import time

repo_root, workdir, output_file = sys.argv[1:4]
responses = [
    "\n",
    "2\n",
    "1\n",
    "http://rainbond.internal\n",
    "y\n",
    "demo\n",
]
expected_prompts = [
    "请输入选项 [1-2]",
    "请输入选项 [1-2]",
    "请输入选项 [1-2]",
    "Rainbond Console 地址: ",
    "是否继续使用明文 HTTP 连接？[y/N]: ",
    "Rainbond 用户名: ",
]

env = os.environ.copy()
env["HOME"] = os.path.join(workdir, "home")
env["SHELL"] = "/bin/zsh"
env["TEST_LOG_DIR"] = os.path.join(workdir, "logs")
env["PATH"] = os.path.join(workdir, "bin") + ":/usr/bin:/bin"
env["RAINBOND_PASSWORD"] = "secret-password"

pid, master_fd = pty.fork()
if pid == 0:
    os.chdir(repo_root)
    script = r'''
source "$1/install.sh" --dest "$HOME/source-probe" --force
trap 'handle_installer_signal 130' INT
trap 'handle_installer_signal 143' TERM
trap 'handle_installer_exit "$?"' EXIT
TARGET=codex
SKIP_MCP=0
NON_INTERACTIVE=0
configure_mcp
'''
    os.execvpe("bash", ["bash", "-c", script, "rainskills-authorization-test", repo_root], env)

buffer = bytearray()
response_index = 0
search_offset = 0
deadline = time.monotonic() + 10

while True:
    if time.monotonic() > deadline:
        with open(output_file, "wb") as fh:
            fh.write(buffer)
        try:
            os.kill(pid, 9)
        except OSError:
            pass
        sys.exit(124)
    ready, _, _ = select.select([master_fd], [], [], 0.2)
    if master_fd in ready:
        try:
            chunk = os.read(master_fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        buffer.extend(chunk)
        text = buffer.decode("utf-8", errors="replace")
        while response_index < len(responses):
            expected = expected_prompts[response_index]
            prompt_index = text.find(expected, search_offset)
            if prompt_index >= 0:
                os.write(master_fd, responses[response_index].encode("utf-8"))
                response_index += 1
                search_offset = prompt_index + len(expected)
            else:
                break
    try:
        done_pid, status = os.waitpid(pid, os.WNOHANG)
    except ChildProcessError:
        done_pid, status = pid, 0
    if done_pid == pid:
        exit_code = os.waitstatus_to_exitcode(status)
        with open(output_file, "wb") as fh:
            fh.write(buffer)
        sys.exit(exit_code)

try:
    _, status = os.waitpid(pid, 0)
    exit_code = os.waitstatus_to_exitcode(status)
except ChildProcessError:
    exit_code = 0

with open(output_file, "wb") as fh:
    fh.write(buffer)
sys.exit(exit_code)
PY
}

run_interactive_no_platform_with_pty() {
  local workdir="$1"
  local output_file="$2"
  python3 - "$REPO_ROOT" "$workdir" "$output_file" <<'PY'
import os
import pty
import select
import sys
import time

repo_root, workdir, output_file = sys.argv[1:4]
responses = ["1\n", "2\n", "2\n"]
prompts = [
    "请输入选项 [1-5]",
    "请输入选项 [1-2]",
    "请输入选项 [1-2]",
]

env = os.environ.copy()
env["HOME"] = os.path.join(workdir, "home")
env["TEST_LOG_DIR"] = os.path.join(workdir, "logs")
env["PATH"] = os.path.join(workdir, "bin") + ":/usr/bin:/bin"

pid, master_fd = pty.fork()
if pid == 0:
    os.chdir(repo_root)
    os.execvpe("bash", ["bash", os.path.join(repo_root, "install.sh")], env)

buffer = bytearray()
response_index = 0
search_offset = 0
deadline = time.monotonic() + 10
status = None

while time.monotonic() < deadline:
    ready, _, _ = select.select([master_fd], [], [], 0.2)
    if master_fd in ready:
        try:
            chunk = os.read(master_fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        buffer.extend(chunk)
        text = buffer.decode("utf-8", errors="replace")
        if response_index < len(responses):
            prompt_index = text.find(prompts[response_index], search_offset)
            if prompt_index >= 0:
                os.write(master_fd, responses[response_index].encode("utf-8"))
                response_index += 1
                search_offset = prompt_index + len(prompts[response_index - 1])
    done_pid, child_status = os.waitpid(pid, os.WNOHANG)
    if done_pid == pid:
        status = child_status
        break

if status is None:
    try:
        os.kill(pid, 9)
    except OSError:
        pass
    with open(output_file, "wb") as fh:
        fh.write(buffer)
    sys.exit(124)

with open(output_file, "wb") as fh:
    fh.write(buffer)
sys.exit(os.waitstatus_to_exitcode(status))
PY
}

test_noninteractive_http_requires_explicit_opt_in() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  set +e
  run_mcp_configuration "$tmpdir" all --non-interactive --rainbond-url http://rainbond.internal --username demo >/tmp/rainbond-install-test.out 2>&1
  local rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected installer to reject non-interactive HTTP without explicit opt-in"
  grep -F -- "--allow-insecure-http" /tmp/rainbond-install-test.out >/dev/null || fail "expected insecure http guidance"
}

test_posix_client_openclaw_is_rejected() {
  local tmpdir output_file rc
  tmpdir="$(mktemp -d)"
  output_file="/tmp/rainbond-install-openclaw-removed.out"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  set +e
  run_installer "$tmpdir" openclaw --skip-mcp --force >"$output_file" 2>&1
  rc=$?
  set -e

  [[ $rc -ne 0 ]] || fail "expected POSIX installer to reject openclaw"
  grep -F -- "macOS/Linux 安装器不再支持 OpenClaw" "$output_file" >/dev/null \
    || fail "expected removed openclaw guidance"
  rm -rf "$tmpdir"
}

test_default_install_is_skills_only() {
  local tmpdir output_file token forbidden
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  output_file="$tmpdir/install.out"
  token="$(make_test_jwt 1893456000)"

  run_installer "$tmpdir" all --non-interactive --saas --token "$token" --force \
    >"$output_file" 2>&1

  assert_exact_capability_summary "$output_file"
  for forbidden in \
    "Rainbond Cloud" \
    "私有" \
    "MCP" \
    "登录" \
    "授权" \
    "Rainbond Console" \
    "rainskills.next-action.v1"; do
    assert_not_contains "$output_file" "$forbidden"
  done

  assert_file_not_exists "$tmpdir/home/.rainbond/mcp.env"
  assert_file_not_exists "$tmpdir/home/.rainbond/rainskills-onboarding-v1.json"
  assert_file_not_exists "$tmpdir/home/.rainbond/platform-installer"
  assert_file_not_exists "$tmpdir/home/.codex/config.toml"
  assert_file_not_exists "$tmpdir/home/.claude.json"
  assert_file_not_exists "$tmpdir/home/.zshrc"
  assert_file_not_exists "$tmpdir/logs/codex.log"
  assert_file_not_exists "$tmpdir/logs/claude.log"
  if [[ -f "$tmpdir/logs/curl.log" ]]; then
    assert_not_contains "$tmpdir/logs/curl.log" "/console/"
  fi
  for technical_detail in \
    "安装到：" \
    "[install]" \
    "项新装" \
    "SKILL.md" \
    "官方文档" \
    "固定运行版本"; do
    assert_not_contains "$output_file" "$technical_detail"
  done
}

test_skills_only_completion_contract_for_every_posix_target() {
  local target tmpdir output_file custom_destination

  for target in codex claude pi dsh workbuddy all; do
    tmpdir="$(mktemp -d)"
    mkdir -p "$tmpdir/home" "$tmpdir/logs"
    make_fake_commands "$tmpdir/bin"
    output_file="$tmpdir/${target}.out"

    run_installer "$tmpdir" "$target" --non-interactive --force >"$output_file" 2>&1

    assert_exact_capability_summary "$output_file"
    if [[ "$target" == "pi" || "$target" == "all" ]]; then
      assert_file_exists "$tmpdir/home/.pi/agent/skills/rainbond-app-assistant/SKILL.md"
    fi
    if [[ "$target" == "dsh" || "$target" == "all" ]]; then
      assert_file_exists "$tmpdir/home/.dsh/skills/rainbond-app-assistant/SKILL.md"
    fi
    if [[ "$target" == "workbuddy" || "$target" == "all" ]]; then
      assert_file_exists "$tmpdir/home/.workbuddy-ai/skills/rainbond-app-assistant/SKILL.md"
    fi
    rm -rf "$tmpdir"
  done

  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  output_file="$tmpdir/custom.out"
  custom_destination="$tmpdir/custom-skills"

  run_installer "$tmpdir" --dest "$custom_destination" --non-interactive --force \
    >"$output_file" 2>&1

  assert_exact_capability_summary "$output_file"
  assert_file_exists "$custom_destination/rainbond-app-assistant/SKILL.md"
  rm -rf "$tmpdir"

  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  output_file="$tmpdir/config-homes.out"
  TEST_DSH_HOME="$tmpdir/dsh-home" \
  TEST_WORKBUDDY_CONFIG_DIR="$tmpdir/workbuddy-home" \
    run_installer "$tmpdir" all --non-interactive --force >"$output_file" 2>&1
  assert_exact_capability_summary "$output_file"
  assert_file_exists "$tmpdir/dsh-home/skills/rainbond-app-assistant/SKILL.md"
  assert_file_exists "$tmpdir/workbuddy-home/skills/rainbond-app-assistant/SKILL.md"
  rm -rf "$tmpdir"
}

test_posix_all_target_installs_every_skill_set_and_preserves_force_counts() {
  local tmpdir output_file second_output source_skill skill_count expected_new expected_unchanged
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p \
    "$tmpdir/home/.codex/skills/rainbond-app-assistant" \
    "$tmpdir/home/.claude/skills/rainbond-app-assistant" \
    "$tmpdir/home/.pi/agent/skills/rainbond-app-assistant" \
    "$tmpdir/home/.dsh/skills/rainbond-app-assistant" \
    "$tmpdir/home/.workbuddy-ai/skills/rainbond-app-assistant" \
    "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"
  printf 'old codex skill\n' > "$tmpdir/home/.codex/skills/rainbond-app-assistant/SKILL.md"
  printf 'old claude skill\n' > "$tmpdir/home/.claude/skills/rainbond-app-assistant/SKILL.md"
  printf 'old pi skill\n' > "$tmpdir/home/.pi/agent/skills/rainbond-app-assistant/SKILL.md"
  printf 'old dsh skill\n' > "$tmpdir/home/.dsh/skills/rainbond-app-assistant/SKILL.md"
  printf 'old workbuddy skill\n' > "$tmpdir/home/.workbuddy-ai/skills/rainbond-app-assistant/SKILL.md"
  source_skill="$REPO_ROOT/rainbond-app-assistant/SKILL.md"
  skill_count="$(find "$REPO_ROOT" -maxdepth 1 -mindepth 1 -type d -name 'rainbond-*' | wc -l | tr -d ' ')"
  if [[ -f "$REPO_ROOT/marketplace/rainskills/skills/rainskills/SKILL.md" ]]; then
    skill_count=$((skill_count + 1))
  fi
  expected_new=$(( (skill_count - 1) * 5 ))
  expected_unchanged=$(( skill_count * 5 ))
  output_file="$tmpdir/force.out"
  second_output="$tmpdir/unchanged.out"

  run_installer "$tmpdir" all --non-interactive --force --verbose >"$output_file" 2>&1

  cmp -s "$source_skill" "$tmpdir/home/.codex/skills/rainbond-app-assistant/SKILL.md" \
    || fail "Codex pre-existing Skill was not force-overwritten"
  cmp -s "$source_skill" "$tmpdir/home/.claude/skills/rainbond-app-assistant/SKILL.md" \
    || fail "Claude pre-existing Skill was not force-overwritten"
  cmp -s "$source_skill" "$tmpdir/home/.pi/agent/skills/rainbond-app-assistant/SKILL.md" \
    || fail "Pi pre-existing Skill was not force-overwritten"
  cmp -s "$source_skill" "$tmpdir/home/.dsh/skills/rainbond-app-assistant/SKILL.md" \
    || fail "DeepSeek Harness pre-existing Skill was not force-overwritten"
  cmp -s "$source_skill" "$tmpdir/home/.workbuddy-ai/skills/rainbond-app-assistant/SKILL.md" \
    || fail "WorkBuddy pre-existing Skill was not force-overwritten"
  assert_contains "$output_file" \
    "安装完成。本次：${expected_new} 项新装 / 0 项已更新 / 0 项已是最新 / 5 项强制覆盖"

  run_installer "$tmpdir" all --non-interactive --verbose >"$second_output" 2>&1
  assert_contains "$second_output" \
    "安装完成。本次：0 项新装 / 0 项已更新 / ${expected_unchanged} 项已是最新 / 0 项强制覆盖"
}

