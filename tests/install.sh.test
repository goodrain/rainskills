test_expired_cached_token_reauthenticates_before_write() {
  local tmpdir expired_token fresh_token
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  mkdir -p "$tmpdir/home" "$tmpdir/logs"
  make_fake_commands "$tmpdir/bin"

  expired_token="$(make_test_jwt 1700000000)"
  fresh_token="$(make_test_jwt 1893456000)"

  RAINBOND_JWT="$expired_token" \
  RAINBOND_URL="http://rainbond.internal" \
  TEST_FAKE_LOGIN_TOKEN="$fresh_token" \
    run_mcp_configuration "$tmpdir" all --non-interactive --rainbond-url http://rainbond.internal --username demo --allow-insecure-http --force \
    >/tmp/rainbond-install-expired-cache.out 2>&1

  assert_contains "$tmpdir/logs/curl.log" "http://rainbond.internal/console/users/login"
