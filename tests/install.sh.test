  assert_file_exists "$tmpdir/home/.pi/agent/extensions/rainskills-mcp.ts"
  cmp -s "$REPO_ROOT/pi/rainskills-mcp.ts" "$tmpdir/home/.pi/agent/extensions/rainskills-mcp.ts" \
    || fail "Pi extension must match the bundled extension"
